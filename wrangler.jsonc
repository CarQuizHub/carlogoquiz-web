{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carlogoquiz-web",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-01-29",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets configuration
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },

  // Service binding to your BE worker
  "services": [
    {
      "binding": "QUIZ_API",
      "service": "carlogoquiz-api"
    }
  ],

  // Production environment variables
  "vars": {
    "MEDIA_BASE_URL": "https://your-production-r2-bucket-url"
  },

  "observability": {
    "enabled": true
  },

  // Development environment
  "env": {
    "dev": {
      "name": "carlogoquiz-web-dev",
      "services": [
        {
          "binding": "QUIZ_API",
          "service": "carlogoquiz-api-dev"
        }
      ],
      "vars": {
        "MEDIA_BASE_URL": "http://localhost:8787"
      }
    },

    // Staging environment
    "staging": {
      "name": "carlogoquiz-web-staging",
      "workers_dev": true,
      "services": [
        {
          "binding": "QUIZ_API",
          "service": "carlogoquiz-api-staging"
        }
      ],
      "vars": {
        "MEDIA_BASE_URL": "https://your-staging-r2-bucket-url"
      }
    }
  }
}
