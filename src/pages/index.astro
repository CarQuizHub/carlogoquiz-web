<style is:global>
  /* ── Viewport-height-responsive hero spacing ── */
  /* Tuned for 1080p (1920×1080) as the primary target */
  /* At 1080px vh: 6vh≈65px, 5vh≈54px, 4vh≈43px, 3vh≈32px */
  .hero-pt {
    padding-top: clamp(4.5rem, 7vh, 6rem);
  }
  .hero-py {
    padding-top: clamp(1.5rem, 3vh, 2rem);
    padding-bottom: clamp(1.5rem, 3vh, 2rem);
  }
  @media (min-width: 768px) {
    .hero-py {
      padding-top: clamp(2.5rem, 5vh, 4rem);
      padding-bottom: clamp(2.5rem, 5vh, 4rem);
    }
  }
  .hero-desc-mb {
    margin-bottom: clamp(3.5rem, 7vh, 5.5rem);
  }
  .hero-ticker-mt {
    margin-top: clamp(2rem, 4vh, 3.5rem);
  }
  .hero-scroll-mt {
    margin-top: clamp(1.5rem, 3vh, 3rem);
  }

    .text-shadow-glow {
    text-shadow: 
      0 0 10px rgba(255, 60, 0, 0.8),
      0 0 20px rgba(255, 60, 0, 0.5),
      0 0 30px rgba(255, 60, 0, 0.3);
  }

    .progress-line {
    animation: progressGrow 2s ease-out 0.5s forwards;
  }

  @keyframes progressGrow {
    to { transform: scaleX(1); }
  }
  /* ── Hero sequential entrance ── */
  .hero-seq {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(20px);
    animation: heroIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  [data-hero="1"] { animation-delay: 0.1s; }
  [data-hero="2"] { animation-delay: 0.3s; transform: translateY(0) scaleX(0.6); }
  [data-hero="3"] { animation-delay: 0.5s; }
  [data-hero="4"] { animation-delay: 0.7s; transform: translateY(12px) scale(0.97); }
  [data-hero="5"] { animation-delay: 0.9s; transform: translateY(16px) scale(0.98); }
  [data-hero="6"] { animation-delay: 1.1s; }
  [data-hero="7"] { animation-delay: 1.4s; transform: translateY(0); filter: blur(8px); }
  [data-hero="8"] { animation-delay: 1.8s; }

  @keyframes heroIn {
    to {
      opacity: 1;
      transform: translateY(0) scale(1) scaleX(1);
      filter: blur(0);
    }
  }

  /* ── Scroll reveal (below fold) ── */
  [data-reveal] {
    opacity: 0;
    filter: blur(6px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-reveal="fade-up"] { transform: translateY(40px); }
  [data-reveal="fade-in"] { transform: none; }
  [data-reveal="scale"] { transform: scale(0.95); }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  /* Staggered children */
  [data-reveal-stagger] > * {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(28px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-reveal-stagger].is-visible > * {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  [data-reveal-stagger].is-visible > *:nth-child(1) { transition-delay: 0ms; }
  [data-reveal-stagger].is-visible > *:nth-child(2) { transition-delay: 150ms; }
  [data-reveal-stagger].is-visible > *:nth-child(3) { transition-delay: 300ms; }
  [data-reveal-stagger].is-visible > *:nth-child(4) { transition-delay: 450ms; }

  /* ── Tier selector active states ── */
  .tier-gauge.gauge-active { opacity: 1; filter: brightness(1.3); }
  .tier-label.label-active { opacity: 1; }
  .tier-card.is-active { border-color: var(--tier-color); box-shadow: 0 0 30px var(--tier-glow); }
  .tier-card[data-tier="rookie"] { --tier-color: rgba(76, 175, 80, 0.3); --tier-glow: rgba(76, 175, 80, 0.08); }
  .tier-card[data-tier="pro"] { --tier-color: rgba(255, 60, 0, 0.3); --tier-glow: rgba(255, 60, 0, 0.08); }
  .tier-card[data-tier="legend"] { --tier-color: rgba(180, 20, 20, 0.3); --tier-glow: rgba(180, 20, 20, 0.08); }
  .tier-card.is-active .tier-label { opacity: 1; }
  .tier-card[data-tier="rookie"].is-active .tier-label { color: #4caf50; }
  .tier-card[data-tier="pro"].is-active .tier-label { color: #ff3c00; }
  .tier-card[data-tier="legend"].is-active .tier-label { color: #b41414; }
  .tier-card[data-tier="rookie"].is-active .tier-pct { color: #4caf50; }
  .tier-card[data-tier="pro"].is-active .tier-pct { color: #ff3c00; }
  .tier-card[data-tier="legend"].is-active .tier-pct { color: #b41414; }

  /* ── Hero title effects ── */

  .hero-title {
    user-select: none;
    -webkit-user-select: none;
  }
  .hero-title-white {
    transition: text-shadow 0.4s ease;
  }

  .hero-title.is-hovered .hero-title-white {
    text-shadow:
      0 0 10px rgba(255, 60, 0, 0.4),
      0 0 30px rgba(255, 60, 0, 0.2),
      0 0 60px rgba(255, 60, 0, 0.1);
  }

  .hero-text-glow-wrap {
    position: relative;
    display: inline-block;
  }

  /* Real text stays on top */
  .hero-text-glow-wrap > .text-gradient-accent {
    position: relative;
    z-index: 1;
  }

  /* Glow layer — no CSS animation, JS drives it */
  [data-glow-layer] {
    position: absolute;
    inset: 0;
    z-index: 0;
    color: #ff3c00;
    filter: blur(18px);
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }
</style>

<script>

  const heroGlow = document.getElementById('hero-glow');
  if (heroGlow) {
    window.addEventListener('scroll', () => {
      const fade = Math.max(0.2, 1 - window.scrollY / (window.innerHeight * 1.5));
      heroGlow.style.opacity = String(fade);
    }, { passive: true });
  }
  // Scroll indicator
  const hint = document.querySelector('[data-scroll-hint]') as HTMLElement;
  const text = document.querySelector('[data-scroll-text]') as HTMLElement;
  if (hint && text) {
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY > 50;
      hint.style.opacity = scrolled ? '0' : '1';
      text.style.opacity = scrolled ? '1' : '0';
    }, { passive: true });
  }

  // Scroll reveal
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => {
    revealObserver.observe(el);
  });

  // Tier selector
  document.querySelectorAll('[data-tier-selector]').forEach((selector) => {
    const cards = selector.querySelectorAll<HTMLElement>('.tier-card');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const wasActive = card.classList.contains('is-active');

        cards.forEach((c) => {
          c.classList.remove('is-active');
          c.querySelector('.tier-gauge')?.classList.remove('gauge-active');
          c.querySelector('.tier-label')?.classList.remove('label-active');
          const bar = c.querySelector('.tier-bar') as HTMLElement;
          if (bar) {
            bar.style.transform = 'scaleX(0)';
          }
        });

        if (!wasActive) {
          card.classList.add('is-active');
          card.querySelector('.tier-gauge')?.classList.add('gauge-active');
          card.querySelector('.tier-label')?.classList.add('label-active');
          const bar = card.querySelector('.tier-bar') as HTMLElement;
          if (bar) {
            bar.style.transform = 'scaleX(1)';
          }
        }
      });
    });
  });

    // Hero title glow — breathing + hover
  const glowEl = document.querySelector('[data-glow-layer]') as HTMLElement;
  const titleEl = document.querySelector('.hero-title') as HTMLElement;

  if (glowEl && titleEl) {
    let hovered = false;
    let on = false;

    // Start after entrance animation finishes
    setTimeout(() => {
      // Fade in to baseline
      glowEl.style.transition = 'opacity 1.5s ease';
      glowEl.style.opacity = '0.4';

      // Begin cycle after baseline is reached
      setTimeout(() => {
        setInterval(() => {
          if (hovered) return;
          on = !on;
          glowEl.style.transition = 'opacity 2s ease';
          glowEl.style.opacity = on ? '0.8' : '0.35';
        }, 2500);
      }, 1500);
    }, 2000);

    titleEl.addEventListener('mouseenter', () => {
      hovered = true;
      titleEl.classList.add('is-hovered');
      glowEl.style.transition = 'opacity 0.3s ease, filter 0.3s ease';
      glowEl.style.opacity = '0.9';
      glowEl.style.filter = 'blur(22px)';
    });

    titleEl.addEventListener('mouseleave', () => {
      hovered = false;
      titleEl.classList.remove('is-hovered');
      glowEl.style.transition = 'opacity 0.8s ease, filter 0.8s ease';
      glowEl.style.opacity = '0.35';
      glowEl.style.filter = 'blur(18px)';
    });
  }

  // Counter animation on scroll
  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const target = entry.target as HTMLElement;
        const finalValue = parseInt(target.dataset.counter || '0');
        const suffix = target.dataset.suffix || '';
        animateCounter(target, 0, finalValue, 1500, suffix);
        counterObserver.unobserve(target);
      }
    });
  }, { threshold: 0.5 });

function animateCounter(el: HTMLElement, start: number, end: number, duration: number, suffix: string = '') {
  const delay = parseInt(el.dataset.delay || '0');
  const customDuration = parseInt(el.dataset.duration || duration.toString());
  
  setTimeout(() => {
    const startTime = performance.now();
    const update = (currentTime: number) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / customDuration, 1);
      const value = Math.floor(start + (end - start) * easeOutCubic(progress));
      el.textContent = value + suffix;
      if (progress < 1) requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
  }, delay);
}

function easeOutCubic(t: number) { 
  return 1 - Math.pow(1 - t, 3); 
}

  // Observe all counters
  document.querySelectorAll('[data-counter]').forEach(el => counterObserver.observe(el));

</script>