---
import Layout from "@components/astro/Layout.astro";
import Header from "@components/astro/Header.astro";
import Footer from "@components/astro/Footer.astro";
import LogoTicker from "@components/astro/Ticker.astro";
import { tickerItems } from "@lib/const";
---

<Layout title="Car Logo Quiz — Test Your Car Brand Knowledge">
  <Header />
  <div
    id="hero-glow"
    class="pointer-events-none fixed inset-0 z-[-1] transition-opacity duration-300"
    aria-hidden="true"
  >
  </div>
  <main
    class="hero-pt mx-auto flex max-w-4xl flex-1 flex-col items-center px-4 pb-8 md:pb-12"
  >
    <section class="hero-py text-center">
      <!-- Title -->
      <h1 class="hero-seq hero-title mb-6 leading-none" data-hero="1">
        <span class="hero-title-white">CAN YOU NAME</span><br />
        <span class="hero-text-glow-wrap">
          <span aria-hidden="true" data-glow-layer>THE CAR LOGO?</span>
          <span class="text-gradient-accent">THE CAR LOGO?</span>
        </span>
      </h1>

      <!-- Divider -->
      <div
        class="w-84 hero-seq mx-auto mb-6 h-px bg-gradient-to-r from-transparent via-accent-primary/50 to-transparent"
        data-hero="2"
      >
      </div>

      <!-- Description -->
      <p class="hero-desc-mb hero-seq mx-auto max-w-md text-lg" data-hero="3">
        TEST YOUR AUTOMOTIVE KNOWLEDGE
      </p>

      <!-- Badge -->
      <div
        class="hero-seq badge badge-lg mb-8 gap-2 border-0 bg-bg-tertiary px-4 py-3 font-mono text-xs uppercase tracking-widest text-text-secondary"
        data-hero="4"
      >
        <div class="inline-grid place-items-center *:[grid-area:1/1]">
          <span class="relative flex h-3 w-3">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-error opacity-75"
            ></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-error"
            ></span>
          </span>
        </div>
        <span
          ><span data-counter="15" data-suffix=" Questions" data-duration="2500"
            >0</span
          ></span
        >
        <span class="relative flex h-3 w-3">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-75"
          ></span>
          <span class="relative inline-flex h-3 w-3 rounded-full bg-success"
          ></span>
        </span>
        <span
          ><span data-counter="3" data-suffix=" Lives" data-duration="2500"
            >0</span
          ></span
        >
      </div><br />

      <!-- CTA Button -->
      <div class="hero-seq inline-block" data-hero="5">
        <span
          class="btn btn-lg inline-flex cursor-default select-none items-center justify-center gap-4 rounded-xl border border-[#ff3c00]/30 bg-[#ff3c00]/40 px-12 py-4 text-lg text-white/60 shadow-[0_0_30px_rgba(255,60,0,0.2),0_0_60px_rgba(255,60,0,0.1)] ring-1 ring-[#ff3c00]/25 backdrop-blur-xl transition-all duration-300 active:scale-[0.97] active:bg-[#ff3c00]/55 active:shadow-[0_0_40px_rgba(255,60,0,0.35),0_0_80px_rgba(255,60,0,0.15)] active:ring-[#ff3c00]/35"
        >
          <span class="text-sm font-medium tracking-widest">COMING SOON</span>
        </span>
      </div>
      <div class="hero-seq mt-6 flex flex-col items-center gap-3" data-hero="6">
        <div
          class="h-px w-48 bg-gradient-to-r from-transparent via-white/10 to-transparent"
        >
        </div>
        <p class="font-mono text-xs uppercase tracking-widest text-text-muted">
          No Sign Up Required • Free to Play
        </p>
      </div>
    </section>

    <!-- Ticker -->
    <div
      class="hero-ticker-mt hero-seq -mx-4 w-[calc(100%+4rem)] max-w-[100vw] lg:-mx-10 lg:w-[calc(100%+12rem)] xl:-mx-14 xl:w-[calc(100%+18rem)]"
      data-hero="7"
    >
      <LogoTicker
        items={tickerItems}
        speedSeconds={48}
        sizePx={60}
        title="FEATURES ICONIC CAR BRANDS FROM AROUND THE WORLD"
      />
    </div>

    <!-- Scroll indicator -->
    <div
      class="hero-scroll-mt hero-seq flex flex-col items-center gap-2"
      data-hero="8"
      data-scroll-indicator
    >
      <div class="transition-opacity duration-500" data-scroll-hint>
        <div class="flex flex-col items-center gap-2">
          <span
            class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-muted/70"
            >Scroll</span
          >
          <div
            class="flex h-8 w-5 justify-center rounded-full border border-white/10 pt-1.5"
          >
            <div
              class="h-2 w-0.5 animate-bounce rounded-full bg-accent-primary/60"
            >
            </div>
          </div>
        </div>
      </div>
      <div class="opacity-0 transition-opacity duration-500" data-scroll-text>
        <div class="flex flex-col items-center gap-3">
          <h2
            class="text-2xl font-extrabold uppercase tracking-tight md:text-3xl"
          >
            How It <span class="text-gradient-accent">Works</span>
          </h2>
          <div
            class="h-px w-48 bg-gradient-to-r from-transparent via-accent-primary/50 to-transparent"
          >
          </div>
        </div>
      </div>
    </div>

    <!-- Features Section -->
    <section
      class="mt-12 grid w-full grid-cols-1 gap-4 md:mt-16 md:grid-cols-4"
      data-reveal-stagger
    >
      <!-- Feature 1: No Time Limit -->
      <div
        class="card-custom card-interactive group card cursor-pointer p-6 text-center transition-all duration-500"
      >
        <!-- Icon container with glow -->
        <div class="relative mx-auto mb-4 h-12 w-12">
          <!-- Glow layer that pulses on hover/tap -->
          <div
            class="absolute inset-0 rounded-xl bg-accent-primary/20 opacity-0 blur-xl transition-opacity duration-500 group-hover:opacity-100 group-active:opacity-100"
          >
          </div>

          <!-- Icon that floats up -->
          <div
            class="relative z-10 flex h-12 w-12 items-center justify-center rounded-xl bg-bg-tertiary text-accent-primary transition-all duration-500 group-hover:-translate-y-1 group-hover:bg-accent-primary/10 group-active:-translate-y-1 group-active:bg-accent-primary/10"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="transition-all duration-500 group-hover:scale-110 group-active:scale-110"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </div>
        </div>

        <!-- Text with subtle transitions -->
        <h3
          class="mb-1 text-sm font-semibold text-text-primary transition-all duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
        >
          No Time Limit
        </h3>
        <p
          class="text-xs text-text-muted transition-all duration-500 group-hover:translate-y-0.5 group-hover:text-text-secondary group-active:translate-y-0.5 group-active:text-text-secondary"
        >
          Take your time to study each logo carefully
        </p>
      </div>

      <!-- Feature 2: 3 Lives -->
      <div
        class="card-custom card-interactive group card cursor-pointer p-6 text-center transition-all duration-500"
      >
        <!-- Icon container with glow -->
        <div class="relative mx-auto mb-4 h-12 w-12">
          <!-- Glow layer that pulses on hover/tap -->
          <div
            class="absolute inset-0 rounded-xl bg-accent-primary/20 opacity-0 blur-xl transition-opacity duration-500 group-hover:opacity-100 group-active:opacity-100"
          >
          </div>

          <!-- Icon that floats up -->
          <div
            class="relative z-10 flex h-12 w-12 items-center justify-center rounded-xl bg-bg-tertiary text-accent-primary transition-all duration-500 group-hover:-translate-y-1 group-hover:bg-accent-primary/10 group-active:-translate-y-1 group-active:bg-accent-primary/10"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="transition-all duration-500 group-hover:scale-110 group-active:scale-110"
            >
              <path
                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
              ></path>
            </svg>
          </div>
        </div>

        <!-- Text with subtle transitions -->
        <h3
          class="mb-1 text-sm font-semibold text-text-primary transition-all duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
        >
          3 Lives
        </h3>
        <p
          class="text-xs text-text-muted transition-all duration-500 group-hover:translate-y-0.5 group-hover:text-text-secondary group-active:translate-y-0.5 group-active:text-text-secondary"
        >
          Make too many mistakes and it's game over
        </p>
      </div>

      <!-- Feature 3: Score Points -->
      <div
        class="card-custom card-interactive group card cursor-pointer p-6 text-center transition-all duration-500"
      >
        <!-- Icon container with glow -->
        <div class="relative mx-auto mb-4 h-12 w-12">
          <!-- Glow layer that pulses on hover/tap -->
          <div
            class="absolute inset-0 rounded-xl bg-accent-primary/20 opacity-0 blur-xl transition-opacity duration-500 group-hover:opacity-100 group-active:opacity-100"
          >
          </div>

          <!-- Icon that floats up -->
          <div
            class="relative z-10 flex h-12 w-12 items-center justify-center rounded-xl bg-bg-tertiary text-accent-primary transition-all duration-500 group-hover:-translate-y-1 group-hover:bg-accent-primary/10 group-active:-translate-y-1 group-active:bg-accent-primary/10"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="transition-all duration-500 group-hover:scale-110 group-active:scale-110"
            >
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
              ></polygon>
            </svg>
          </div>
        </div>

        <!-- Text with subtle transitions -->
        <h3
          class="mb-1 text-sm font-semibold text-text-primary transition-all duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
        >
          Score Points
        </h3>
        <p
          class="text-xs text-text-muted transition-all duration-500 group-hover:translate-y-0.5 group-hover:text-text-secondary group-active:translate-y-0.5 group-active:text-text-secondary"
        >
          Harder logos earn more points
        </p>
      </div>

      <!-- Feature 4: Increasing Difficulty -->
      <div
        class="card-custom card-interactive group card cursor-pointer p-6 text-center transition-all duration-500"
      >
        <!-- Icon container with glow -->
        <div class="relative mx-auto mb-4 h-12 w-12">
          <!-- Glow layer that pulses on hover/tap -->
          <div
            class="absolute inset-0 rounded-xl bg-accent-primary/20 opacity-0 blur-xl transition-opacity duration-500 group-hover:opacity-100 group-active:opacity-100"
          >
          </div>

          <!-- Icon that floats up -->
          <div
            class="relative z-10 flex h-12 w-12 items-center justify-center rounded-xl bg-bg-tertiary text-accent-primary transition-all duration-500 group-hover:-translate-y-1 group-hover:bg-accent-primary/10 group-active:-translate-y-1 group-active:bg-accent-primary/10"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="transition-all duration-500 group-hover:scale-110 group-active:scale-110"
            >
              <path d="M3 17l6-6 4 4 8-8"></path>
              <path d="M14 7h7v7"></path>
            </svg>
          </div>
        </div>

        <!-- Text with subtle transitions -->
        <h3
          class="mb-1 text-sm font-semibold text-text-primary transition-all duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
        >
          Gets Harder
        </h3>
        <p
          class="text-xs text-text-muted transition-all duration-500 group-hover:translate-y-0.5 group-hover:text-text-secondary group-active:translate-y-0.5 group-active:text-text-secondary"
        >
          Each correct answer ramps up the challenge
        </p>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="mt-16 w-full md:mt-24">
      <!-- Steps -->
      <div
        class="relative grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8"
        data-reveal-stagger
      >
        <!-- Progress line (hidden on mobile) -->
        <div
          class="absolute left-0 right-0 top-14 -z-10 hidden h-0.5 bg-white/5 md:block"
          aria-hidden="true"
        >
          <div
            class="progress-line h-full origin-left scale-x-0 bg-gradient-accent"
          >
          </div>
        </div>

        <!-- Step 1 -->
        <div
          class="card-custom card-interactive group card relative cursor-pointer overflow-hidden p-8 transition-all duration-500 hover:-translate-y-2 hover:border-accent-primary/30 hover:shadow-[0_0_40px_rgba(255,60,0,0.15)] active:-translate-y-2 active:border-accent-primary/30 active:shadow-[0_0_40px_rgba(255,60,0,0.15)]"
        >
          <span
            class="pointer-events-none absolute -left-1 -top-4 select-none font-mono text-[7rem] font-extrabold leading-none text-white/[0.03] transition-all duration-500 group-hover:scale-110 group-hover:text-white/[0.06] group-active:scale-110 group-active:text-white/[0.06]"
            >01</span
          >

          <div class="relative z-10">
            <!-- Animated badge -->
            <div
              class="relative mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-accent font-mono text-sm font-bold text-bg-primary transition-all duration-500 group-hover:rotate-6 group-hover:scale-110 group-hover:shadow-glow-sm group-active:rotate-6 group-active:scale-110 group-active:shadow-glow-sm"
            >
              <div
                class="absolute inset-0 rounded-lg bg-gradient-accent opacity-0 blur-lg transition-opacity duration-500 group-hover:opacity-60 group-active:opacity-60"
              >
              </div>
              <span class="relative z-10">01</span>
            </div>

            <h3
              class="mb-2 text-lg font-bold uppercase tracking-wide text-text-primary transition-colors duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
            >
              See the Logo
            </h3>
            <p
              class="text-sm leading-relaxed text-text-secondary transition-colors duration-300 group-hover:text-text-primary group-active:text-text-primary"
            >
              A car logo appears on screen — some iconic, some obscure. Study it
              carefully before making your move.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div
          class="card-custom card-interactive group card relative cursor-pointer overflow-hidden p-8 transition-all duration-500 hover:-translate-y-2 hover:border-accent-primary/30 hover:shadow-[0_0_40px_rgba(255,60,0,0.15)] active:-translate-y-2 active:border-accent-primary/30 active:shadow-[0_0_40px_rgba(255,60,0,0.15)]"
        >
          <span
            class="pointer-events-none absolute -left-1 -top-4 select-none font-mono text-[7rem] font-extrabold leading-none text-white/[0.03] transition-all duration-500 group-hover:scale-110 group-hover:text-white/[0.06] group-active:scale-110 group-active:text-white/[0.06]"
            >02</span
          >

          <div class="relative z-10">
            <div
              class="relative mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-accent font-mono text-sm font-bold text-bg-primary transition-all duration-500 group-hover:rotate-6 group-hover:scale-110 group-hover:shadow-glow-sm group-active:rotate-6 group-active:scale-110 group-active:shadow-glow-sm"
            >
              <div
                class="absolute inset-0 rounded-lg bg-gradient-accent opacity-0 blur-lg transition-opacity duration-500 group-hover:opacity-60 group-active:opacity-60"
              >
              </div>
              <span class="relative z-10">02</span>
            </div>

            <h3
              class="mb-2 text-lg font-bold uppercase tracking-wide text-text-primary transition-colors duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
            >
              Make Your Guess
            </h3>
            <p
              class="text-sm leading-relaxed text-text-secondary transition-colors duration-300 group-hover:text-text-primary group-active:text-text-primary"
            >
              Type the brand name or choose from multiple options. The faster
              and more accurate, the better.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div
          class="card-custom card-interactive group card relative cursor-pointer overflow-hidden p-8 transition-all duration-500 hover:-translate-y-2 hover:border-accent-primary/30 hover:shadow-[0_0_40px_rgba(255,60,0,0.15)] active:-translate-y-2 active:border-accent-primary/30 active:shadow-[0_0_40px_rgba(255,60,0,0.15)]"
        >
          <span
            class="pointer-events-none absolute -left-1 -top-4 select-none font-mono text-[7rem] font-extrabold leading-none text-white/[0.03] transition-all duration-500 group-hover:scale-110 group-hover:text-white/[0.06] group-active:scale-110 group-active:text-white/[0.06]"
            >03</span
          >

          <div class="relative z-10">
            <div
              class="relative mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-accent font-mono text-sm font-bold text-bg-primary transition-all duration-500 group-hover:rotate-6 group-hover:scale-110 group-hover:shadow-glow-sm group-active:rotate-6 group-active:scale-110 group-active:shadow-glow-sm"
            >
              <div
                class="absolute inset-0 rounded-lg bg-gradient-accent opacity-0 blur-lg transition-opacity duration-500 group-hover:opacity-60 group-active:opacity-60"
              >
              </div>
              <span class="relative z-10">03</span>
            </div>

            <h3
              class="mb-2 text-lg font-bold uppercase tracking-wide text-text-primary transition-colors duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
            >
              Climb the Ranks
            </h3>
            <p
              class="text-sm leading-relaxed text-text-secondary transition-colors duration-300 group-hover:text-text-primary group-active:text-text-primary"
            >
              Score points, beat your personal record, and challenge your
              friends to see who knows their cars best.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Decoration -->
    <section class="mt-12 w-full md:mt-16" data-reveal="fade-up">
      <div
        class="stats stats-vertical w-full rounded-3xl bg-bg-secondary px-6 py-6 md:stats-horizontal md:px-12"
      >
        <div class="stat place-items-center md:-translate-x-2">
          <div
            class="stat-value font-mono text-2xl font-bold text-text-primary md:text-3xl"
            data-counter="100"
            data-suffix="+"
          >
            0
          </div>
          <div
            class="stat-desc text-xs uppercase tracking-wider text-text-muted"
          >
            Car Brands
          </div>
        </div>

        <div class="stat place-items-center">
          <div
            class="stat-value font-mono text-2xl font-bold text-text-primary md:text-3xl"
            data-counter="5"
          >
            0
          </div>
          <div
            class="stat-desc text-xs uppercase tracking-wider text-text-muted"
          >
            Difficulty Levels
          </div>
        </div>

        <div class="stat place-items-center">
          <div
            class="stat-value font-mono text-2xl font-bold text-text-primary md:text-3xl"
            data-counter="18"
          >
            0
          </div>
          <div
            class="stat-desc text-xs uppercase tracking-wider text-text-muted"
          >
            Different Countries
          </div>
        </div>
      </div>
    </section>

    <!-- Coming Soon Section -->
    <section class="mt-16 w-full md:mt-24">
      <!-- Section Header -->
      <div class="mb-12 text-center" data-reveal="fade-up">
        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent-primary/20 bg-accent-primary/5 px-4 py-1.5"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-primary opacity-75"
            ></span>
            <span
              class="relative inline-flex h-2 w-2 rounded-full bg-accent-primary"
            ></span>
          </span>
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-accent-primary"
            >In Development</span
          >
        </div>
        <h2
          class="mb-3 text-2xl font-extrabold uppercase tracking-tight md:text-3xl"
        >
          Coming <span class="text-gradient-accent">Soon</span>
        </h2>
        <p class="mx-auto max-w-md text-sm text-text-muted">
          We're building new ways to play — here's what's on the roadmap
        </p>
        <div
          class="mx-auto mt-4 h-px w-48 bg-gradient-to-r from-transparent via-accent-primary/30 to-transparent"
        >
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2" data-reveal-stagger>
        <!-- Choose Your Challenge -->
        <div
          class="card-custom card relative overflow-hidden p-8 md:col-span-2"
        >
          <div class="relative z-10">
            <div class="mb-2 flex items-center gap-3">
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg bg-bg-tertiary text-accent-primary"
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-lg font-bold uppercase tracking-wide text-text-primary"
                >
                  Choose Your Challenge
                </h3>
                <p class="text-xs text-text-muted">
                  From everyday brands to rare classics
                </p>
              </div>
            </div>

            <!-- Difficulty Tiers — Rev Gauges -->
            <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
              <!-- Rookie -->
              <div
                class="tier-card card-interactive group flex cursor-pointer flex-col items-center gap-3 rounded-xl border border-white/5 bg-bg-tertiary/50 p-5 transition-all duration-500 hover:scale-[1.03] hover:border-success/30 hover:shadow-[0_0_30px_rgba(76,175,80,0.08)] active:scale-[1.03] active:border-success/30 active:shadow-[0_0_30px_rgba(76,175,80,0.08)]"
                data-tier="rookie"
              >
                <div class="relative">
                  <div
                    class="tier-gauge radial-progress text-success/40 transition-all duration-500 group-hover:text-success/80 group-active:text-success/80"
                    style="--value:30; --size:5.5rem; --thickness:5px;"
                    role="progressbar"
                  >
                    <span
                      class="tier-pct font-mono text-xs font-bold text-text-muted transition-colors duration-300 group-hover:text-success group-active:text-success"
                      >30%</span
                    >
                  </div>
                  <div
                    class="radial-progress absolute inset-0 text-white/[0.03]"
                    style="--value:100; --size:5.5rem; --thickness:5px;"
                    role="presentation"
                  >
                  </div>
                </div>
                <div class="text-center">
                  <h4
