---
import Layout from '@components/astro/Layout.astro';
import Header from '@components/astro/Header.astro';
---

<Layout title="Home">
  <Header />
  
  <main class="home">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>15 Questions • 3 Lives</span>
      </div>
      
      <h1 class="hero-title">
        Can You Identify<br />
        <span class="title-accent">Every Logo?</span>
      </h1>
      
      <p class="hero-description">
        Put your automotive knowledge to the test. From legendary marques 
        to modern manufacturers — prove you know your cars.
      </p>
      
      <a href="/quiz" class="start-button">
        <span class="button-text">Start Challenge</span>
        <span class="button-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>
    </section>

    <!-- Features Section -->
    <section class="features">
      <div class="feature">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </div>
        <h3>No Time Limit</h3>
        <p>Take your time to study each logo carefully</p>
      </div>
      
      <div class="feature">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <h3>3 Lives</h3>
        <p>Make too many mistakes and it's game over</p>
      </div>
      
      <div class="feature">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </div>
        <h3>Score Points</h3>
        <p>Harder logos earn more points</p>
      </div>
    </section>

    <!-- Stats decoration -->
    <div class="stats-decoration">
      <div class="stat">
        <span class="stat-number">50+</span>
        <span class="stat-label">Car Brands</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-number">5</span>
        <span class="stat-label">Difficulty Levels</span>
      </div>
    </div>
  </main>
</Layout>

<style>
  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-xl) var(--space-md);
    max-width: 640px;
    margin: 0 auto;
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: var(--space-2xl) 0;
    animation: fadeIn 0.6s ease;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xl);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  .hero-title {
    margin-bottom: var(--space-lg);
    line-height: 1.1;
  }

  .title-accent {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.125rem;
    max-width: 440px;
    margin: 0 auto var(--space-xl);
  }

  /* Start Button */
  .start-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-2xl);
    background: var(--gradient-accent);
    color: var(--color-bg-primary);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glow);
    transition: all var(--transition-base);
  }

  .start-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 50px rgba(0, 212, 255, 0.5);
    color: var(--color-bg-primary);
  }

  .button-icon {
    display: flex;
    transition: transform var(--transition-base);
  }

  .start-button:hover .button-icon {
    transform: translateX(4px);
  }

  /* Features */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    width: 100%;
    margin-top: var(--space-3xl);
    animation: fadeIn 0.6s ease 0.2s backwards;
  }

  .feature {
    text-align: center;
    padding: var(--space-lg);
    background: var(--color-bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base);
  }

  .feature:hover {
    border-color: rgba(0, 212, 255, 0.2);
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-md);
    color: var(--color-accent-primary);
    margin-bottom: var(--space-md);
  }

  .feature h3 {
    font-size: 0.9rem;
    margin-bottom: var(--space-xs);
  }

  .feature p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* Stats */
  .stats-decoration {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    margin-top: var(--space-3xl);
    padding: var(--space-lg) var(--space-2xl);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-xl);
    animation: fadeIn 0.6s ease 0.4s backwards;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-bg-tertiary);
  }

  /* Responsive */
  @media (max-width: 540px) {
    .features {
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: 2rem;
    }

    .start-button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
