---
import Layout from '@components/astro/Layout.astro';
import Header from '@components/astro/Header.astro';
import Footer from '@components/astro/Footer.astro';
import LogoTicker from '@components/astro/Ticker.astro';
import { tickerItems } from '@lib/const';
---

<Layout title="Home">
  <Header />
  <div id="hero-glow" class="fixed inset-0 pointer-events-none z-[-1] transition-opacity duration-300" aria-hidden="true"></div>
  <main class="flex-1 flex flex-col items-center px-4 pb-8 md:pb-12 max-w-4xl mx-auto hero-pt">
    <section class="text-center hero-py">

      <!-- Title -->
      <h1 class="mb-6 leading-none hero-seq hero-title" data-hero="1">
        <span class="hero-title-white">CAN YOU NAME</span><br />
        <span class="hero-text-glow-wrap">
          <span aria-hidden="true" data-glow-layer>THE CAR LOGO?</span>
          <span class="text-gradient-accent">THE CAR LOGO?</span>
        </span>
      </h1>

      <!-- Divider -->
      <div class="w-84 h-px mx-auto mb-6 bg-gradient-to-r from-transparent via-accent-primary/50 to-transparent hero-seq" data-hero="2"></div>
      
      <!-- Description -->
      <p class="text-lg max-w-md mx-auto hero-desc-mb hero-seq" data-hero="3">
        TEST YOUR AUTOMOTIVE KNOWLEDGE
      </p>

      <!-- Badge -->
      <div class="badge badge-lg gap-2 px-4 py-3 bg-bg-tertiary border-0 text-text-secondary font-mono text-xs uppercase tracking-widest mb-8 hero-seq" data-hero="4">
        <div class="inline-grid *:[grid-area:1/1] place-items-center">
          <span class="relative flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full rounded-full bg-error opacity-75 animate-ping"></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-error"></span>
          </span>
        </div>
        <span><span data-counter="15" data-suffix=" Questions" data-duration="2500">0</span></span>
        <span class="relative flex h-3 w-3">
          <span class="absolute inline-flex h-full w-full rounded-full bg-success opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-3 w-3 rounded-full bg-success"></span>
        </span>
        <span><span data-counter="3" data-suffix=" Lives" data-duration="2500">0</span></span>
      </div><br>
      
      <!-- CTA Button -->
      <a href="/quiz" class="btn btn-lg btn-glow gap-4 px-12 py-4 text-lg rounded-xl group hero-seq" data-hero="5">
        <span>TAKE THE QUIZ NOW</span>
        <span class="transition-transform duration-250 group-hover:translate-x-1">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>
      <div class="mt-6 flex flex-col items-center gap-3 hero-seq" data-hero="6">
        <div class="w-48 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
        <p class="text-xs font-mono uppercase tracking-widest text-text-muted">
        No Sign Up Required • Free to Play
        </p>
      </div>
    </section>

    <!-- Ticker -->
    <div class="w-[calc(100%+4rem)] lg:w-[calc(100%+12rem)] xl:w-[calc(100%+18rem)] max-w-[100vw] hero-ticker-mt -mx-4 lg:-mx-10 xl:-mx-14 hero-seq" data-hero="7">
      <LogoTicker items={tickerItems} speedSeconds={48} sizePx={60} title="FEATURES ICONIC CAR BRANDS FROM AROUND THE WORLD" />
    </div>

    <!-- Scroll indicator -->
    <div class="hero-scroll-mt flex flex-col items-center gap-2 hero-seq" data-hero="8" data-scroll-indicator>
      <div class="transition-opacity duration-500" data-scroll-hint>
        <div class="flex flex-col items-center gap-2">
          <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-text-muted/70">Scroll</span>
          <div class="w-5 h-8 rounded-full border border-white/10 flex justify-center pt-1.5">
            <div class="w-0.5 h-2 rounded-full bg-accent-primary/60 animate-bounce"></div>
          </div>
        </div>
      </div>
      <div class="transition-opacity duration-500 opacity-0" data-scroll-text>
        <div class="flex flex-col items-center gap-3">
          <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight">
            How It <span class="text-gradient-accent">Works</span>
          </h2>
          <div class="w-48 h-px bg-gradient-to-r from-transparent via-accent-primary/50 to-transparent"></div>
        </div>
      </div>
    </div>

    <!-- Features Section -->
    <section class="grid grid-cols-1 md:grid-cols-4 gap-4 w-full mt-12 md:mt-16" data-reveal-stagger>
      <!-- Feature 1: No Time Limit -->
      <div class="card card-custom p-6 text-center hover:border-accent-primary/20 group cursor-default transition-all duration-500">
        <!-- Icon container with glow -->
        <div class="relative w-12 h-12 mx-auto mb-4">
          <!-- Glow layer that pulses on hover -->
          <div class="absolute inset-0 bg-accent-primary/20 rounded-xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <!-- Icon that floats up -->
          <div class="relative z-10 w-12 h-12 bg-bg-tertiary rounded-xl flex items-center justify-center text-accent-primary transition-all duration-500 group-hover:-translate-y-1 group-hover:bg-accent-primary/10">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-all duration-500 group-hover:scale-110">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
        </div>
        
        <!-- Text with subtle transitions -->
        <h3 class="text-sm font-semibold mb-1 text-text-primary transition-all duration-300 group-hover:text-accent-primary">
          No Time Limit
        </h3>
        <p class="text-xs text-text-muted transition-all duration-500 group-hover:text-text-secondary group-hover:translate-y-0.5">
          Take your time to study each logo carefully
        </p>
      </div>
      
      <!-- Feature 2: 3 Lives -->
      <div class="card card-custom p-6 text-center hover:border-accent-primary/20 group cursor-default transition-all duration-500">
        <!-- Icon container with glow -->
        <div class="relative w-12 h-12 mx-auto mb-4">
          <!-- Glow layer that pulses on hover -->
          <div class="absolute inset-0 bg-accent-primary/20 rounded-xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <!-- Icon that floats up -->
          <div class="relative z-10 w-12 h-12 bg-bg-tertiary rounded-xl flex items-center justify-center text-accent-primary transition-all duration-500 group-hover:-translate-y-1 group-hover:bg-accent-primary/10">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-all duration-500 group-hover:scale-110">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
        </div>
        
        <!-- Text with subtle transitions -->
        <h3 class="text-sm font-semibold mb-1 text-text-primary transition-all duration-300 group-hover:text-accent-primary">
          3 Lives
        </h3>
        <p class="text-xs text-text-muted transition-all duration-500 group-hover:text-text-secondary group-hover:translate-y-0.5">
          Make too many mistakes and it's game over
        </p>
      </div>
      
      <!-- Feature 3: Score Points -->
      <div class="card card-custom p-6 text-center hover:border-accent-primary/20 group cursor-default transition-all duration-500">
        <!-- Icon container with glow -->
        <div class="relative w-12 h-12 mx-auto mb-4">
          <!-- Glow layer that pulses on hover -->
          <div class="absolute inset-0 bg-accent-primary/20 rounded-xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <!-- Icon that floats up -->
          <div class="relative z-10 w-12 h-12 bg-bg-tertiary rounded-xl flex items-center justify-center text-accent-primary transition-all duration-500 group-hover:-translate-y-1 group-hover:bg-accent-primary/10">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-all duration-500 group-hover:scale-110">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
        </div>
        
        <!-- Text with subtle transitions -->
        <h3 class="text-sm font-semibold mb-1 text-text-primary transition-all duration-300 group-hover:text-accent-primary">
          Score Points
        </h3>
        <p class="text-xs text-text-muted transition-all duration-500 group-hover:text-text-secondary group-hover:translate-y-0.5">
          Harder logos earn more points
        </p>
      </div>

      <!-- Feature 4: Increasing Difficulty -->
      <div class="card card-custom p-6 text-center hover:border-accent-primary/20 group cursor-default transition-all duration-500">
        <!-- Icon container with glow -->
        <div class="relative w-12 h-12 mx-auto mb-4">
          <!-- Glow layer that pulses on hover -->
          <div class="absolute inset-0 bg-accent-primary/20 rounded-xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <!-- Icon that floats up -->
          <div class="relative z-10 w-12 h-12 bg-bg-tertiary rounded-xl flex items-center justify-center text-accent-primary transition-all duration-500 group-hover:-translate-y-1 group-hover:bg-accent-primary/10">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-all duration-500 group-hover:scale-110">
              <path d="M3 17l6-6 4 4 8-8"/>
              <path d="M14 7h7v7"/>
            </svg>
          </div>
        </div>
        
        <!-- Text with subtle transitions -->
        <h3 class="text-sm font-semibold mb-1 text-text-primary transition-all duration-300 group-hover:text-accent-primary">
          Gets Harder
        </h3>
        <p class="text-xs text-text-muted transition-all duration-500 group-hover:text-text-secondary group-hover:translate-y-0.5">
          Each correct answer ramps up the challenge
        </p>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="mt-16 md:mt-24 w-full">
      <!-- Steps -->
      <div class="relative grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8" data-reveal-stagger>
        
        <!-- Progress line (hidden on mobile) -->
        <div class="hidden md:block absolute top-14 left-0 right-0 h-0.5 bg-white/5 -z-10" aria-hidden="true">
          <div class="progress-line h-full bg-gradient-accent origin-left scale-x-0"></div>
        </div>
        
        <!-- Step 1 -->
        <div class="card card-custom p-8 relative overflow-hidden group cursor-default
                    transition-all duration-500 hover:border-accent-primary/30 
                    hover:shadow-[0_0_40px_rgba(255,60,0,0.15)] hover:-translate-y-2">
          <span class="absolute -top-4 -left-1 text-[7rem] font-extrabold leading-none text-white/[0.03] font-mono select-none pointer-events-none 
                      transition-all duration-500 group-hover:text-white/[0.06] group-hover:scale-110">01</span>
          
          <div class="relative z-10">
            <!-- Animated badge -->
            <div class="relative w-10 h-10 rounded-lg bg-gradient-accent flex items-center justify-center text-sm font-bold text-bg-primary font-mono mb-5
                        transition-all duration-500 group-hover:scale-110 group-hover:rotate-6 group-hover:shadow-glow-sm">
              <div class="absolute inset-0 bg-gradient-accent rounded-lg blur-lg opacity-0 group-hover:opacity-60 transition-opacity duration-500"></div>
              <span class="relative z-10">01</span>
            </div>
            
            <h3 class="text-lg font-bold text-text-primary mb-2 uppercase tracking-wide 
                      transition-colors duration-300 group-hover:text-accent-primary">
              See the Logo
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed transition-colors duration-300 group-hover:text-text-primary">
              A car logo appears on screen — some iconic, some obscure. Study it carefully before making your move.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="card card-custom p-8 relative overflow-hidden group cursor-default
                    transition-all duration-500 hover:border-accent-primary/30 
                    hover:shadow-[0_0_40px_rgba(255,60,0,0.15)] hover:-translate-y-2">
          <span class="absolute -top-4 -left-1 text-[7rem] font-extrabold leading-none text-white/[0.03] font-mono select-none pointer-events-none 
                      transition-all duration-500 group-hover:text-white/[0.06] group-hover:scale-110">02</span>
          
          <div class="relative z-10">
            <div class="relative w-10 h-10 rounded-lg bg-gradient-accent flex items-center justify-center text-sm font-bold text-bg-primary font-mono mb-5
                        transition-all duration-500 group-hover:scale-110 group-hover:rotate-6 group-hover:shadow-glow-sm">
              <div class="absolute inset-0 bg-gradient-accent rounded-lg blur-lg opacity-0 group-hover:opacity-60 transition-opacity duration-500"></div>
              <span class="relative z-10">02</span>
            </div>
            
            <h3 class="text-lg font-bold text-text-primary mb-2 uppercase tracking-wide 
                      transition-colors duration-300 group-hover:text-accent-primary">
              Make Your Guess
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed transition-colors duration-300 group-hover:text-text-primary">
              Type the brand name or choose from multiple options. The faster and more accurate, the better.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="card card-custom p-8 relative overflow-hidden group cursor-default
                    transition-all duration-500 hover:border-accent-primary/30 
                    hover:shadow-[0_0_40px_rgba(255,60,0,0.15)] hover:-translate-y-2">
          <span class="absolute -top-4 -left-1 text-[7rem] font-extrabold leading-none text-white/[0.03] font-mono select-none pointer-events-none 
                      transition-all duration-500 group-hover:text-white/[0.06] group-hover:scale-110">03</span>
          
          <div class="relative z-10">
            <div class="relative w-10 h-10 rounded-lg bg-gradient-accent flex items-center justify-center text-sm font-bold text-bg-primary font-mono mb-5
                        transition-all duration-500 group-hover:scale-110 group-hover:rotate-6 group-hover:shadow-glow-sm">
              <div class="absolute inset-0 bg-gradient-accent rounded-lg blur-lg opacity-0 group-hover:opacity-60 transition-opacity duration-500"></div>
              <span class="relative z-10">03</span>
            </div>
            
            <h3 class="text-lg font-bold text-text-primary mb-2 uppercase tracking-wide 
                      transition-colors duration-300 group-hover:text-accent-primary">
              Climb the Ranks
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed transition-colors duration-300 group-hover:text-text-primary">
              Score points, beat your personal record, and challenge your friends to see who knows their cars best.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Stats Decoration -->
    <section class="mt-12 md:mt-16 w-full" data-reveal="fade-up">
      <div class="stats stats-vertical md:stats-horizontal w-full bg-bg-secondary rounded-3xl px-6 md:px-12 py-6">
        <div class="stat place-items-center md:-translate-x-2">
          <div class="stat-value font-mono text-2xl md:text-3xl font-bold text-text-primary" data-counter="100" data-suffix="+">0</div>
          <div class="stat-desc text-xs uppercase tracking-wider text-text-muted">Car Brands</div>
        </div>

        <div class="stat place-items-center">
          <div class="stat-value font-mono text-2xl md:text-3xl font-bold text-text-primary" data-counter="5">0</div>
          <div class="stat-desc text-xs uppercase tracking-wider text-text-muted">Difficulty Levels</div>
        </div>

        <div class="stat place-items-center">
          <div class="stat-value font-mono text-2xl md:text-3xl font-bold text-text-primary" data-counter="18">0</div>
          <div class="stat-desc text-xs uppercase tracking-wider text-text-muted">Different Countries</div>
        </div>
      </div>
    </section>

    <!-- Coming Soon Section -->
    <section class="mt-16 md:mt-24 w-full">
      <!-- Section Header -->
      <div class="text-center mb-12" data-reveal="fade-up">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-accent-primary/20 bg-accent-primary/5 mb-5">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-accent-primary opacity-75 animate-ping"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-primary"></span>
          </span>
          <span class="text-[10px] font-mono uppercase tracking-widest text-accent-primary">In Development</span>
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight mb-3">
          Coming <span class="text-gradient-accent">Soon</span>
        </h2>
        <p class="text-sm text-text-muted max-w-md mx-auto">
          We're building new ways to play — here's what's on the roadmap
        </p>
        <div class="w-48 h-px mx-auto mt-4 bg-gradient-to-r from-transparent via-accent-primary/30 to-transparent"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal-stagger>

        <!-- Choose Your Challenge -->
        <div class="card card-custom p-8 md:col-span-2 relative overflow-hidden">
          <div class="relative z-10">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-lg bg-bg-tertiary flex items-center justify-center text-accent-primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-text-primary uppercase tracking-wide">Choose Your Challenge</h3>
                <p class="text-xs text-text-muted">From everyday brands to rare classics</p>
              </div>
            </div>

          <!-- Difficulty Tiers — Rev Gauges -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-6" data-tier-selector>
            <!-- Rookie -->
            <button class="tier-card group flex flex-col items-center gap-3 p-5 rounded-xl border border-white/5 bg-bg-tertiary/50 cursor-pointer transition-all duration-300 hover:scale-[1.03] hover:border-success/30 hover:shadow-[0_0_30px_rgba(76,175,80,0.08)] focus:outline-none" data-tier="rookie">
              <div class="relative">
                <div class="tier-gauge radial-progress text-success/40 transition-all duration-500 group-hover:text-success/80" style="--value:30; --size:5.5rem; --thickness:5px;" role="progressbar">
                  <span class="tier-pct text-xs font-mono font-bold text-text-muted transition-colors duration-300">30%</span>
                </div>
                <div class="absolute inset-0 radial-progress text-white/[0.03]" style="--value:100; --size:5.5rem; --thickness:5px;" role="presentation"></div>
              </div>
              <div class="text-center">
                <h4 class="tier-label text-sm font-bold text-text-muted uppercase tracking-wider transition-colors duration-300 group-hover:text-success">Rookie</h4>
                <p class="text-xs text-text-muted mt-0.5">Popular brands everyone knows</p>
              </div>
              <div class="tier-bar h-1 w-8 rounded-full bg-success scale-x-0 transition-transform duration-300"></div>
            </button>

            <!-- Pro -->
            <button class="tier-card group flex flex-col items-center gap-3 p-5 rounded-xl border border-white/5 bg-bg-tertiary/50 cursor-pointer transition-all duration-300 hover:scale-[1.03] hover:border-accent-primary/30 hover:shadow-[0_0_30px_rgba(255,60,0,0.08)] focus:outline-none" data-tier="pro">
              <div class="relative">
                <div class="tier-gauge radial-progress text-accent-primary/40 transition-all duration-500 group-hover:text-accent-primary/80" style="--value:65; --size:5.5rem; --thickness:5px;" role="progressbar">
                  <span class="tier-pct text-xs font-mono font-bold text-text-muted transition-colors duration-300">65%</span>
                </div>
                <div class="absolute inset-0 radial-progress text-white/[0.03]" style="--value:100; --size:5.5rem; --thickness:5px;" role="presentation"></div>
              </div>
              <div class="text-center">
                <h4 class="tier-label text-sm font-bold text-text-muted uppercase tracking-wider transition-colors duration-300 group-hover:text-accent-primary">Pro</h4>
                <p class="text-xs text-text-muted mt-0.5">A solid mix of common & niche</p>
              </div>
              <div class="tier-bar h-1 w-8 rounded-full bg-accent-primary scale-x-0 transition-transform duration-300"></div>
            </button>

            <!-- Legend -->
          <button class="tier-card group flex flex-col items-center gap-3 p-5 rounded-xl border border-white/5 bg-bg-tertiary/50 cursor-pointer transition-all duration-300 hover:scale-[1.03] hover:border-[#b41414]/30 hover:shadow-[0_0_30px_rgba(180,20,20,0.08)] focus:outline-none" data-tier="legend">
            <div class="relative">
              <div class="tier-gauge radial-progress text-[#b41414]/40 transition-all duration-500 group-hover:text-[#b41414]/80" style="--value:95; --size:5.5rem; --thickness:5px;" role="progressbar">
                <span class="tier-pct text-xs font-mono font-bold text-text-muted transition-colors duration-300">95%</span>
              </div>
              <div class="absolute inset-0 radial-progress text-white/[0.03]" style="--value:100; --size:5.5rem; --thickness:5px;" role="presentation"></div>
            </div>
            <div class="text-center">
              <h4 class="tier-label text-sm font-bold text-text-muted uppercase tracking-wider transition-colors duration-300 group-hover:text-[#b41414]">Legend</h4>
              <p class="text-xs text-text-muted mt-0.5">Rare & obscure — true experts only</p>
            </div>
            <div class="tier-bar h-1 w-8 rounded-full bg-[#b41414] scale-x-0 transition-transform duration-300"></div>
          </button>
          </div>
          </div>
        </div>

        <!-- Leaderboards -->
        <div class="card card-custom p-8 relative overflow-hidden group cursor-default
                    transition-all duration-500 hover:border-accent-primary/30 
                    hover:shadow-[0_0_40px_rgba(255,60,0,0.12)]">
          <div class="relative z-10">
            <!-- Icon with glow -->
            <div class="relative w-10 h-10 rounded-lg bg-bg-tertiary flex items-center justify-center text-accent-primary mb-5
                        transition-all duration-500 group-hover:scale-110 group-hover:bg-accent-primary/10">
              <!-- Glow effect -->
              <div class="absolute inset-0 bg-accent-primary/20 rounded-lg blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="relative z-10 transition-transform duration-500 group-hover:scale-110">
                <path d="M8 21h8M12 17v4M6 3h12l-1.5 6.5a1 1 0 0 1-1 .75h-7a1 1 0 0 1-1-.75L6 3z"/>
                <path d="M6 3C3.5 5 3 8 4.5 10.5"/>
                <path d="M18 3c2.5 2 3 5 1.5 7.5"/>
              </svg>
            </div>
            
            <h3 class="text-lg font-bold text-text-primary mb-2 uppercase tracking-wide
                      transition-colors duration-300 group-hover:text-accent-primary">
              Leaderboards
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-4 transition-colors duration-300 group-hover:text-text-primary">
              Compete for the top spot. See how your score stacks up against players worldwide with global rankings.
            </p>
            
            <!-- Animated leaderboard preview -->
            <div class="space-y-2" data-leaderboard>
              <!-- 1st Place - rises highest -->
              <div class="leaderboard-row flex items-center gap-3 px-3 py-2 rounded-lg bg-bg-primary/50 border border-white/5
