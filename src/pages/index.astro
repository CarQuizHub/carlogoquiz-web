<style is:global>
  /* ── Viewport-height-responsive hero spacing ── */
  /* Default: 1080p values (compressed) */
  /* @media min-height 1000px: 1440p+ values (original) */
  .hero-pt {
    padding-top: 5rem;
  }
  .hero-py {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .hero-py {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }
  }
  .hero-desc-mb {
    margin-bottom: 5rem;
  }
  .hero-ticker-mt {
    margin-top: 4.5rem;
  }
  .hero-scroll-mt {
    margin-top: 9.5rem;
  }

  /* 1440p+ */
  @media (min-height: 1200px) {
    .hero-pt {
      padding-top: 6rem;
    }
    .hero-py {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
    .hero-desc-mb {
      margin-bottom: 8rem;
    }
    .hero-ticker-mt {
      margin-top: 6.5rem;
    }
    .hero-scroll-mt {
      margin-top: 9.5rem;
    }
  }
  @media (min-height: 1200px) and (min-width: 768px) {
    .hero-py {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }

  .text-shadow-glow {
    text-shadow:
      0 0 10px rgba(255, 60, 0, 0.8),
      0 0 20px rgba(255, 60, 0, 0.5),
      0 0 30px rgba(255, 60, 0, 0.3);
  }

  .progress-line {
    animation: progressGrow 2s ease-out 0.5s forwards;
  }

  @keyframes progressGrow {
    to {
      transform: scaleX(1);
    }
  }
  /* ── Hero sequential entrance ── */
  .hero-seq {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(20px);
    animation: heroIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  [data-hero="1"] {
    animation-delay: 0.1s;
  }
  [data-hero="2"] {
    animation-delay: 0.3s;
    transform: translateY(0) scaleX(0.6);
  }
  [data-hero="3"] {
    animation-delay: 0.5s;
  }
  [data-hero="4"] {
    animation-delay: 0.7s;
    transform: translateY(12px) scale(0.97);
  }
  [data-hero="5"] {
    animation-delay: 0.9s;
    transform: translateY(16px) scale(0.98);
  }
  [data-hero="6"] {
    animation-delay: 1.1s;
  }
  [data-hero="7"] {
    animation-delay: 1.4s;
    transform: translateY(0);
    filter: blur(8px);
  }
  [data-hero="8"] {
    animation-delay: 1.8s;
  }

  @keyframes heroIn {
    to {
      opacity: 1;
      transform: translateY(0) scale(1) scaleX(1);
      filter: blur(0);
    }
  }

  /* ── Scroll reveal (below fold) ── */
  [data-reveal] {
    opacity: 0;
    filter: blur(6px);
    transition:
      opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-reveal="fade-up"] {
    transform: translateY(40px);
  }
  [data-reveal="fade-in"] {
    transform: none;
  }
  [data-reveal="scale"] {
    transform: scale(0.95);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  /* Staggered children */
  [data-reveal-stagger] > * {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(28px);
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-reveal-stagger].is-visible > * {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  [data-reveal-stagger].is-visible > *:nth-child(1) {
    transition-delay: 0ms;
  }
  [data-reveal-stagger].is-visible > *:nth-child(2) {
    transition-delay: 150ms;
  }
  [data-reveal-stagger].is-visible > *:nth-child(3) {
    transition-delay: 300ms;
  }
  [data-reveal-stagger].is-visible > *:nth-child(4) {
    transition-delay: 450ms;
  }

  /* ── Hero title effects ── */

  .hero-title {
    user-select: none;
    -webkit-user-select: none;
  }
  .hero-title-white {
    transition: text-shadow 0.4s ease;
  }

  .hero-title.is-hovered .hero-title-white {
    text-shadow:
      0 0 10px rgba(255, 60, 0, 0.4),
      0 0 30px rgba(255, 60, 0, 0.2),
      0 0 60px rgba(255, 60, 0, 0.1);
  }

  .hero-text-glow-wrap {
    position: relative;
    display: inline-block;
  }

  /* Real text stays on top */
  .hero-text-glow-wrap > .text-gradient-accent {
    position: relative;
    z-index: 1;
  }

  /* Glow layer — no CSS animation, JS drives it */
  [data-glow-layer] {
    position: absolute;
    inset: 0;
    z-index: 0;
    color: #ff3c00;
    filter: blur(18px);
    opacity: 0;
    pointer-events: none;
    user-select: none;
  } /* Mobile-specific touch improvements */
  @media (hover: none) and (pointer: coarse) {
    /* Ensure interactive elements have proper touch targets */
    .tier-card,
    .card-interactive {
      min-height: 48px;
    }

    /* Optimize touch performance */
    .card-interactive,
    .tier-card {
      -webkit-tap-highlight-color: rgba(255, 60, 0, 0.1);
    }

    /* Touch feedback state */
    .card-interactive.touching {
      transform: scale(0.98);
      opacity: 0.95;
    }
  }
</style>

<script>
  const heroGlow = document.getElementById("hero-glow");
  if (heroGlow) {
    window.addEventListener(
      "scroll",
      () => {
        const fade = Math.max(
          0.2,
          1 - window.scrollY / (window.innerHeight * 1.5),
        );
        heroGlow.style.opacity = String(fade);
      },
      { passive: true },
    );
  }
  // Scroll indicator
  const hint = document.querySelector("[data-scroll-hint]") as HTMLElement;
  const text = document.querySelector("[data-scroll-text]") as HTMLElement;
  if (hint && text) {
    window.addEventListener(
      "scroll",
      () => {
        const scrolled = window.scrollY > 50;
        hint.style.opacity = scrolled ? "0" : "1";
        text.style.opacity = scrolled ? "1" : "0";
      },
      { passive: true },
    );
  }

  // Scroll reveal
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
  );

  document
    .querySelectorAll("[data-reveal], [data-reveal-stagger]")
    .forEach((el) => {
      revealObserver.observe(el);
    });

  // Add instant feedback to CTA buttons
  document.querySelectorAll(".btn-glow").forEach((button) => {
    const addPressEffect = () => {
      button.classList.add("btn-pressing");
    };

    const removePressEffect = () => {
      button.classList.remove("btn-pressing");
    };

    // Mouse events
    button.addEventListener("mousedown", addPressEffect);
    button.addEventListener("mouseup", removePressEffect);
    button.addEventListener("mouseleave", removePressEffect);

    // Touch events
    button.addEventListener("touchstart", addPressEffect, { passive: true });
    button.addEventListener("touchend", removePressEffect, { passive: true });
    button.addEventListener("touchcancel", removePressEffect, {
      passive: true,
    });
  });

  // Add touch feedback to all interactive cards
  document.querySelectorAll(".card-interactive").forEach((card) => {
    const addTouchEffect = () => {
      card.classList.add("touching");
    };

    const removeTouchEffect = () => {
      card.classList.remove("touching");
    };

    // Mouse events (for desktop and DevTools)
    card.addEventListener("mousedown", addTouchEffect);
    card.addEventListener("mouseup", removeTouchEffect);
    card.addEventListener("mouseleave", removeTouchEffect);

    // Touch events (for mobile)
    card.addEventListener("touchstart", addTouchEffect, { passive: true });
    card.addEventListener("touchend", removeTouchEffect, { passive: true });
    card.addEventListener("touchcancel", removeTouchEffect, { passive: true });
  });

  // Hero title glow — breathing + hover/touch
  const glowEl = document.querySelector("[data-glow-layer]") as HTMLElement;
  const titleEl = document.querySelector(".hero-title") as HTMLElement;

  if (glowEl && titleEl) {
    let interacting = false;
    let on = false;
    let breathingInterval: number;

    const startBreathing = () => {
      breathingInterval = setInterval(() => {
        if (interacting) return;
        on = !on;
        glowEl.style.transition = "opacity 2s ease";
        glowEl.style.opacity = on ? "0.8" : "0.35";
      }, 2500) as unknown as number;
    };
    window.addEventListener("beforeunload", () => {
      clearInterval(breathingInterval);
    });

    // Start after entrance animation finishes
    setTimeout(() => {
      // Fade in to baseline
      glowEl.style.transition = "opacity 1.5s ease";
      glowEl.style.opacity = "0.4";

      // Begin cycle after baseline is reached
      setTimeout(() => {
        startBreathing();
      }, 1500);
    }, 2000);

    const handleInteractionStart = () => {
      interacting = true;
      titleEl.classList.add("is-hovered");
      glowEl.style.transition = "opacity 0.3s ease, filter 0.3s ease";
      glowEl.style.opacity = "0.9";
      glowEl.style.filter = "blur(22px)";
    };

    const handleInteractionEnd = () => {
      interacting = false;
      titleEl.classList.remove("is-hovered");
      glowEl.style.transition = "opacity 0.8s ease, filter 0.8s ease";
      glowEl.style.opacity = "0.35";
      glowEl.style.filter = "blur(18px)";
    };

    // Mouse events
    titleEl.addEventListener("mouseenter", handleInteractionStart);
    titleEl.addEventListener("mouseleave", handleInteractionEnd);

    // Touch events
    titleEl.addEventListener("touchstart", handleInteractionStart, {
      passive: true,
    });
    titleEl.addEventListener("touchend", handleInteractionEnd, {
      passive: true,
    });
    titleEl.addEventListener("touchcancel", handleInteractionEnd, {
      passive: true,
    });
  }

  // Counter animation on scroll
  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const finalValue = parseInt(target.dataset.counter || "0");
          const suffix = target.dataset.suffix || "";
          animateCounter(target, 0, finalValue, 1500, suffix);
          counterObserver.unobserve(target);
        }
      });
    },
    { threshold: 0.5 },
  );

  function animateCounter(
    el: HTMLElement,
    start: number,
    end: number,
    duration: number,
    suffix: string = "",
  ) {
    const delay = parseInt(el.dataset.delay || "0");
    const customDuration = parseInt(el.dataset.duration || duration.toString());

    setTimeout(() => {
      const startTime = performance.now();
      const update = (currentTime: number) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / customDuration, 1);
        const value = Math.floor(
          start + (end - start) * easeOutCubic(progress),
        );
        el.textContent = value + suffix;
        if (progress < 1) requestAnimationFrame(update);
      };
      requestAnimationFrame(update);
    }, delay);
  }

  function easeOutCubic(t: number) {
    return 1 - Math.pow(1 - t, 3);
  }

  // Observe all counters
  document
    .querySelectorAll("[data-counter]")
    .forEach((el) => counterObserver.observe(el));
</script>
