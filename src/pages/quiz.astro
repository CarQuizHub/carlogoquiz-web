---
import Layout from '@components/astro/Layout.astro';
import Header from '@components/astro/Header.astro';
import Quiz from '@components/svelte/Quiz.svelte';

// Get media base URL from Cloudflare environment
const mediaBaseUrl = Astro.locals.runtime.env.MEDIA_BASE_URL;
---

<Layout title="Play" description="Play the Car Logo Quiz - Can you identify all 15 car logos?">
  <Header showBackLink={true} />
  
  <main class="quiz-page">
    <Quiz 
      client:load 
      mediaBaseUrl={mediaBaseUrl}
    />
  </main>
</Layout>

<style>
  .quiz-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    max-width: 560px;
    margin: 0 auto;
    padding: var(--space-md);
    width: 100%;
  }
</style>
