---
import Layout from '@components/astro/Layout.astro';
import Header from '@components/astro/Header.astro';
import Footer from '@components/astro/Footer.astro';

const lastUpdated = "February 8, 2026";

const sections = [
  {
    title: "What this page covers",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
    </svg>`,
    body: `
      <p>
        This Privacy & Cookies page explains what information is stored or accessed when you play CarLogoQuiz,
        and what choices you have. This is a free-to-play quiz with no sign up.
      </p>
      <p class="mt-3 text-xs text-text-muted">
        <span class="font-mono uppercase tracking-widest text-text-muted/70">Last updated:</span>
        <span class="font-mono">${lastUpdated}</span>
      </p>
    `
  },
  {
    title: "Do you collect personal data?",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      <path d="M9 12l2 2 4-4"/>
    </svg>`,
    body: `
      <p>
        We do not ask for your name, email address, or any account details to play.
        Your quiz progress is stored locally on your device (in your browser) so you can continue where you left off.
      </p>
      <p class="mt-3">
        Like most websites, our hosting provider may process basic technical information such as your IP address,
        device/browser details, and request logs to deliver the site reliably and protect it from abuse.
      </p>
    `
  },
  {
    title: "Cookies & local storage",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20 12a8 8 0 1 1-8-8c.5 2.5 2.5 4 5 4 0 2.5 1.5 4.5 3 4z"/>
      <path d="M9 13h.01"/><path d="M13 16h.01"/><path d="M7 10h.01"/><path d="M15 11h.01"/>
    </svg>`,
    body: `
      <p>
        CarLogoQuiz uses browser storage to remember things like your progress, high score, difficulty, or UI preferences.
        This helps the quiz work the way you expect without an account.
      </p>

      <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="bg-bg-tertiary/50 border border-white/5 rounded-xl p-4">
          <p class="text-xs font-mono uppercase tracking-widest text-text-muted/70">Local Storage</p>
          <p class="text-sm text-text-secondary mt-2 leading-relaxed">
            Stores quiz state on your device (e.g. score / streak / lives / settings). Not sent to us by default.
          </p>
        </div>
        <div class="bg-bg-tertiary/50 border border-white/5 rounded-xl p-4">
          <p class="text-xs font-mono uppercase tracking-widest text-text-muted/70">Cookies</p>
          <p class="text-sm text-text-secondary mt-2 leading-relaxed">
            May be used for essential site functionality. If used, they are not for advertising and do not contain your identity.
          </p>
        </div>
      </div>

      <p class="mt-4 text-sm text-text-secondary leading-relaxed">
        If we ever add analytics, ads, accounts, payments, or third-party embeds, we’ll update this page and (where required)
        show a cookie/consent prompt before setting non-essential cookies.
      </p>
    `
  },
  {
    title: "What you can control",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v4"/><path d="M12 18v4"/>
      <path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/>
      <path d="M2 12h4"/><path d="M18 12h4"/>
      <path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>`,
    body: `
      <p>
        You can clear your locally stored quiz data at any time. This will reset your progress on this device.
      </p>

      <div class="mt-5 flex flex-col sm:flex-row items-center gap-3">
        <button id="reset-local" class="btn btn-sm bg-bg-tertiary border border-white/5 text-text-secondary text-xs font-mono uppercase tracking-widest
          hover:border-accent-primary/30 hover:text-accent-primary transition-[border-color,box-shadow] duration-300">
          Reset Local Data
        </button>

        <span id="reset-status" class="text-xs font-mono text-text-muted/70" aria-live="polite"></span>
      </div>

      <div class="mt-4 text-xs text-text-muted/70 leading-relaxed">
        <p class="mb-1">
          Tip: You can also clear site data in your browser settings (cookies + local storage).
        </p>
        <p>
          If your browser blocks storage, some features (like saving progress) may not work properly.
        </p>
      </div>
    `
  },
  {
    title: "Third parties",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20 7h-9"/><path d="M14 17H5"/><path d="M20 17h-3"/><path d="M7 7H4"/>
      <circle cx="9" cy="7" r="2"/><circle cx="15" cy="17" r="2"/>
    </svg>`,
    body: `
      <p>
        We don’t embed advertising trackers or social widgets on purpose. However, the infrastructure that delivers a website
        (hosting, CDN, and security services) may handle basic connection data to serve pages and prevent abuse.
      </p>
      <p class="mt-3">
        If we add third-party services (analytics, payments, etc.), we’ll list them here and explain what they do.
      </p>
    `
  },
  {
    title: "Contact",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>`,
    body: `
      <p>
        Questions about privacy or data? Reach out:
      </p>
      <div class="mt-4 inline-flex items-center gap-3 px-4 py-3 rounded-xl border border-white/5 bg-bg-tertiary/50">
        <div class="w-9 h-9 rounded-lg bg-bg-primary/50 border border-white/5 flex items-center justify-center text-accent-primary/70">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16v16H4z"/><path d="m22 6-10 7L2 6"/>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted/70">Email</p>
          <p class="text-sm text-text-secondary">
            <a href="mailto:carlogoquizteam@gmail.com" class="hover:text-accent-primary transition-colors duration-300">carlogoquizteam@gmail.com</a>
          </p>
        </div>
      </div>
    `
  }
];
---

<Layout title="Privacy" description="Privacy & Cookies information for CarLogoQuiz">
  <Header/>
  <div id="hero-glow" class="fixed inset-0 pointer-events-none z-[-1] transition-opacity duration-300" aria-hidden="true"></div>

  <main class="flex-1 flex flex-col items-center px-4 pb-10 md:pb-14 max-w-3xl mx-auto pt-[7rem] relative">

    <!-- Page Header -->
    <section class="text-center mb-12 md:mb-16 w-full relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-accent-primary/20 bg-accent-primary/5 mb-5 p-entrance" style="animation-delay: 0.1s;">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-accent-primary opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-primary"></span>
        </span>
        <span class="text-[10px] font-mono uppercase tracking-widest text-accent-primary">Privacy</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-extrabold uppercase tracking-tight mb-4 p-entrance" style="animation-delay: 0.2s;">
        Privacy & <span class="text-gradient-accent">Cookies</span>
      </h1>

      <p class="text-sm text-text-muted max-w-md mx-auto p-entrance" style="animation-delay: 0.35s;">
        Simple, transparent, and built for a free-to-play quiz.
      </p>

      <div class="w-48 h-px mx-auto mt-5 bg-gradient-to-r from-transparent via-accent-primary/40 to-transparent p-entrance" style="animation-delay: 0.45s;"></div>
    </section>

    <!-- Quick highlights (now animates in + proper group hover glow) -->
    <section class="w-full grid grid-cols-1 md:grid-cols-3 gap-4 mb-14 md:mb-16 relative z-10">
      <div
        class="card card-custom card-interactive group p-5 text-center p-entrance
              transition-all duration-500
              hover:border-accent-primary/20 hover:shadow-[0_0_40px_rgba(255,60,0,0.08)] hover:-translate-y-1
              active:-translate-y-1"
        style="animation-delay: 0.55s;"
      >
        <div class="relative w-10 h-10 mx-auto mb-3">
          <div class="absolute inset-0 bg-accent-primary/20 rounded-xl blur-xl opacity-0 group-hover:opacity-100 group-active:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 w-10 h-10 rounded-xl bg-bg-tertiary flex items-center justify-center text-accent-primary/70
                      transition-all duration-500 group-hover:bg-accent-primary/10 group-hover:text-accent-primary group-hover:-translate-y-0.5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
        </div>
        <p class="text-xs font-mono uppercase tracking-widest text-text-muted/70">No sign up</p>
        <p class="text-sm text-text-secondary mt-2">Play instantly without creating an account.</p>
      </div>

      <div
        class="card card-custom card-interactive group p-5 text-center p-entrance
              transition-all duration-500
              hover:border-accent-primary/20 hover:shadow-[0_0_40px_rgba(255,60,0,0.08)] hover:-translate-y-1
              active:-translate-y-1"
        style="animation-delay: 0.65s;"
      >
        <div class="relative w-10 h-10 mx-auto mb-3">
          <div class="absolute inset-0 bg-accent-primary/20 rounded-xl blur-xl opacity-0 group-hover:opacity-100 group-active:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 w-10 h-10 rounded-xl bg-bg-tertiary flex items-center justify-center text-accent-primary/70
                      transition-all duration-500 group-hover:bg-accent-primary/10 group-hover:text-accent-primary group-hover:-translate-y-0.5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 12a8 8 0 1 1-8-8c.5 2.5 2.5 4 5 4 0 2.5 1.5 4.5 3 4z"/>
            </svg>
          </div>
        </div>
        <p class="text-xs font-mono uppercase tracking-widest text-text-muted/70">Local progress</p>
        <p class="text-sm text-text-secondary mt-2">Saves on your device via browser storage and in the cloud via cloudflare durable objects.</p>
      </div>

      <div
        class="card card-custom card-interactive group p-5 text-center p-entrance
              transition-all duration-500
              hover:border-accent-primary/20 hover:shadow-[0_0_40px_rgba(255,60,0,0.08)] hover:-translate-y-1
              active:-translate-y-1"
        style="animation-delay: 0.75s;"
      >
        <div class="relative w-10 h-10 mx-auto mb-3">
          <div class="absolute inset-0 bg-accent-primary/20 rounded-xl blur-xl opacity-0 group-hover:opacity-100 group-active:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 w-10 h-10 rounded-xl bg-bg-tertiary flex items-center justify-center text-accent-primary/70
                      transition-all duration-500 group-hover:bg-accent-primary/10 group-hover:text-accent-primary group-hover:-translate-y-0.5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
        </div>
        <p class="text-xs font-mono uppercase tracking-widest text-text-muted/70">You’re in control</p>
        <p class="text-sm text-text-secondary mt-2">Reset local data any time.</p>
      </div>
    </section>

    <!-- Accordion sections (FAQ-like) -->
    <section class="w-full space-y-3 relative z-10" id="privacy-list">
      {sections.map((s, index) => (
        <div
          class="collapse collapse-arrow bg-bg-card border border-white/5 rounded-2xl p-item group/privacy transition-[border-color,box-shadow] duration-500
                 hover:border-accent-primary/20 hover:shadow-[0_0_30px_rgba(255,60,0,0.06)] p-entrance"
          style={`animation-delay: ${0.55 + index * 0.1}s;`}
        >
          <input type="checkbox" />

          <div class="collapse-title pr-12 py-5 md:py-6 flex items-center gap-4 cursor-pointer">
            <div class="w-10 h-10 shrink-0 rounded-xl bg-bg-tertiary flex items-center justify-center text-accent-primary/60
                        transition-[border-color,box-shadow,transform,background-color,color] duration-500
                        group-hover/privacy:text-accent-primary group-hover/privacy:bg-accent-primary/10 group-hover/privacy:-translate-y-0.5">
              <Fragment set:html={s.icon} />
            </div>
            <span class="text-sm md:text-base font-semibold text-text-primary transition-colors duration-300 group-hover/privacy:text-accent-primary leading-snug">
              {s.title}
            </span>
          </div>

          <div class="collapse-content px-6 pb-0">
            <div class="pl-14 pb-6">
              <div class="w-10 h-px bg-gradient-to-r from-accent-primary/30 to-transparent mb-4"></div>
              <div class="text-sm text-text-secondary leading-relaxed privacy-rich" set:html={s.body} />
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- CTA -->
    <section class="mt-12 md:mt-16 mb-2 w-full p-entrance relative z-10" style="animation-delay: 1.25s;">
      <div class="relative rounded-3xl border border-white/5 bg-bg-secondary overflow-hidden px-6 py-12 md:py-14 text-center">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,60,0,0.06)_0%,transparent_70%)] pointer-events-none"></div>

        <div class="relative z-10 flex flex-col items-center gap-5">
          <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight leading-tight">
            Ready to <span class="text-gradient-accent">Play?</span>
          </h2>

          <p class="text-sm text-text-muted max-w-sm">
            No accounts. No friction. Just logos.
          </p>

          <div class="w-48 h-px bg-gradient-to-r from-transparent via-accent-primary/30 to-transparent"></div>

          <a href="/quiz" class="btn btn-lg btn-glow gap-4 px-12 py-4 text-lg rounded-xl group inline-flex items-center justify-center">
            <span>START THE QUIZ</span>
            <span class="transition-transform duration-250 group-hover:translate-x-1 group-active:translate-x-1">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style is:global>
  /* ── Entrance animation ── */
  .p-entrance {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(20px);
    animation: pIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes pIn {
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  /* ── DaisyUI accordion tweaks ── */
  .p-item .collapse-title {
    font-size: inherit;
    font-weight: inherit;
    min-height: unset;
    padding-left: 1.5rem;
  }

  .p-item .collapse-title::after {
    color: rgba(255, 255, 255, 0.2);
    transition: color 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-item:hover .collapse-title::after {
    color: rgba(255, 60, 0, 0.6);
  }

  .p-item input:checked ~ .collapse-title::after {
    color: #ff3c00;
  }

  .p-item:has(input:checked) {
    border-color: rgba(255, 60, 0, 0.25);
    box-shadow:
      0 0 30px rgba(255, 60, 0, 0.06),
      inset 3px 0 0 rgba(255, 60, 0, 0.6);
  }

  .p-item:has(input:checked) .collapse-title > div:first-child {
    background: rgba(255, 60, 0, 0.1);
    color: #ff3c00;
  }

  .p-item:has(input:checked) .collapse-title span {
    color: #ff3c00;
  }

  .privacy-rich p { margin-top: 0.6rem; }
  .privacy-rich p:first-child { margin-top: 0; }

  @media (prefers-reduced-motion: reduce) {
    .p-entrance { animation: none !important; opacity: 1 !important; transform: none !important; filter: none !important; }
  }
</style>

<script>
  const heroGlow = document.getElementById('hero-glow');
  if (heroGlow) {
    window.addEventListener('scroll', () => {
      const fade = Math.max(0.25, 1 - window.scrollY / (window.innerHeight * 2.5));
      heroGlow.style.opacity = String(fade);
    }, { passive: true });
  }

  const resetBtn = document.getElementById('reset-local');
  const statusEl = document.getElementById('reset-status');

  function clearCookiesForSite() {
    const cookies = document.cookie.split(';').map(c => c.trim()).filter(Boolean);
    const hostname = window.location.hostname;
    const domainParts = hostname.split('.');
    const baseDomain = domainParts.length >= 2 ? '.' + domainParts.slice(-2).join('.') : hostname;

    cookies.forEach((cookie) => {
      const name = cookie.split('=')[0];
      document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
      document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=${baseDomain}`;
      document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=${hostname}`;
    });
  }

  if (resetBtn && statusEl) {
    resetBtn.addEventListener('click', () => {
      try {
        localStorage.clear();
        sessionStorage.clear();
        clearCookiesForSite();

        statusEl.textContent = "Local data cleared. Refreshing…";
        setTimeout(() => window.location.reload(), 650);
      } catch (e) {
        statusEl.textContent = "Couldn’t clear data automatically. Try clearing site data in your browser settings.";
      }
    }, { passive: true });
  }
</script>
