---
import Header from "@components/astro/Header.astro";
import Layout from "@components/astro/Layout.astro";
---

<Layout title="Page Not Found">
  <Header />
  <div
    id="hero-glow"
    class="pointer-events-none fixed inset-0 z-[-1]"
    aria-hidden="true"
  >
  </div>
  <main
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-4"
  >
    <!-- Animated road lines background -->
    <div
      class="pointer-events-none absolute inset-0 overflow-hidden"
      aria-hidden="true"
    >
      <div class="road-lines">
        <div class="road-line road-line-1"></div>
        <div class="road-line road-line-2"></div>
        <div class="road-line road-line-3"></div>
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-lg text-center">
      <!-- Glitchy 404 code -->
      <div class="error-404-wrap mb-6" data-glitch="404">
        <span
          class="error-404 select-none font-mono font-extrabold leading-none"
          aria-label="404"
        >
          404
        </span>
      </div>

      <!-- Divider -->
      <div
        class="error-seq mx-auto mb-6 h-px w-48 bg-gradient-to-r from-transparent via-accent-primary/50 to-transparent"
        data-seq="1"
      >
      </div>

      <!-- Speedometer / interactive element -->
      <div class="error-seq relative mx-auto mb-8 h-48 w-48" data-seq="2">
        <canvas id="speedometer" width="192" height="192" class="h-full w-full"
        ></canvas>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span
            class="font-mono text-3xl font-bold text-text-primary"
            id="speed-value">0</span
          >
          <span
            class="mt-0.5 font-mono text-[9px] uppercase tracking-widest text-text-muted"
            >MPH</span
          >
        </div>
      </div>

      <!-- Title -->
      <h1
        class="error-seq mb-3 text-2xl font-extrabold uppercase tracking-tight md:text-3xl"
        data-seq="3"
      >
        Wrong <span class="text-gradient-accent">Turn</span>
      </h1>

      <!-- Description -->
      <p
        class="error-seq mx-auto mb-8 max-w-xs text-sm text-text-muted"
        data-seq="4"
      >
        Looks like you've driven off the map. This road doesn't lead anywhere.
      </p>

      <!-- CTA -->
      <div class="error-seq" data-seq="5">
        <a
          href="/"
          class="btn-glow group btn btn-lg inline-flex items-center justify-center gap-3 rounded-xl px-10 py-3.5 text-base"
        >
          <span
            class="duration-250 transition-transform group-hover:-translate-x-1 group-active:-translate-x-1"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
          </span>
          <span>BACK TO HOME</span>
        </a>
      </div>

      <!-- Subtle footer text -->
      <div class="error-seq mt-8" data-seq="6">
        <div
          class="mx-auto mb-3 h-px w-32 bg-gradient-to-r from-transparent via-white/10 to-transparent"
        >
        </div>
        <p
          class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-muted/85"
        >
          Error 404 • Page Not Found
        </p>
      </div>
    </div>

    <!-- Floating particles -->
    <div
      class="pointer-events-none absolute inset-0"
      id="particles"
      aria-hidden="true"
    >
    </div>
  </main>
</Layout>

<style is:global>
  /* ── 404 number with glitch effect ── */
  .error-404-wrap {
    position: relative;
    display: inline-block;
  }

  .error-404 {
    font-size: clamp(7rem, 20vw, 10rem);
    background: linear-gradient(135deg, #ff3c00, #ff6b35, #ff3c00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
    animation: errorIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    filter: blur(10px);
    transform: scale(0.9);
  }

  @keyframes errorIn {
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  /* Glitch layers */
  .error-404-wrap::before,
  .error-404-wrap::after {
    content: attr(data-glitch);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    font-size: clamp(7rem, 20vw, 10rem);
    font-family: "Space Mono", monospace;
    font-weight: 800;
    line-height: 1;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
    pointer-events: none;
    opacity: 0;
  }

  .error-404-wrap::before {
    background: linear-gradient(135deg, #ff3c00, #ff6b35);
    -webkit-background-clip: text;
    animation: glitch1 4s ease-in-out infinite;
    animation-delay: 2s;
  }

  .error-404-wrap::after {
    background: linear-gradient(135deg, #ff6b35, #ff3c00);
    -webkit-background-clip: text;
    animation: glitch2 4s ease-in-out infinite;
    animation-delay: 2s;
  }

  @keyframes glitch1 {
    0%,
    85%,
    100% {
      opacity: 0;
      transform: translate(0);
    }
    86% {
      opacity: 0.6;
      transform: translate(-3px, -1px);
    }
    87% {
      opacity: 0;
      transform: translate(0);
    }
    92% {
      opacity: 0.4;
      transform: translate(2px, 1px);
    }
    93% {
      opacity: 0;
    }
  }

  @keyframes glitch2 {
    0%,
    87%,
    100% {
      opacity: 0;
      transform: translate(0);
    }
    88% {
      opacity: 0.5;
      transform: translate(3px, 2px);
    }
    89% {
      opacity: 0;
      transform: translate(0);
    }
    94% {
      opacity: 0.3;
      transform: translate(-2px, -1px);
    }
    95% {
      opacity: 0;
    }
  }

  /* Glow behind the 404 */
  .error-404-wrap {
    filter: drop-shadow(0 0 60px rgba(255, 60, 0, 0.15));
  }

  /* ── Sequential entrance ── */
  .error-seq {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(16px);
    animation: errorSeqIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  [data-seq="1"] {
    animation-delay: 0.5s;
    transform: translateY(0) scaleX(0.5);
  }
  [data-seq="2"] {
    animation-delay: 0.7s;
  }
  [data-seq="3"] {
    animation-delay: 0.9s;
  }
  [data-seq="4"] {
    animation-delay: 1.1s;
  }
  [data-seq="5"] {
    animation-delay: 1.3s;
    transform: translateY(12px) scale(0.98);
  }
  [data-seq="6"] {
    animation-delay: 1.5s;
  }

  @keyframes errorSeqIn {
    to {
      opacity: 1;
      transform: translateY(0) scale(1) scaleX(1);
      filter: blur(0);
    }
  }

  /* ── Road lines ── */
  .road-lines {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
    opacity: 0.06;
  }

  .road-line {
    width: 3px;
    height: 40px;
    background: white;
    border-radius: 2px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    animation: roadScroll 2s linear infinite;
  }

  .road-line-1 {
    animation-delay: 0s;
  }
  .road-line-2 {
    animation-delay: 0.66s;
  }
  .road-line-3 {
    animation-delay: 1.33s;
  }

  @keyframes roadScroll {
    0% {
      top: -50px;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 100vh;
      opacity: 0;
    }
  }

  /* ── Floating particles ── */
  .particle {
    position: absolute;
    width: 2px;
    height: 2px;
    background: rgba(255, 60, 0, 0.3);
    border-radius: 50%;
    animation: particleFloat linear infinite;
  }

  @keyframes particleFloat {
    0% {
      transform: translateY(0) translateX(0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      transform: translateY(-100vh) translateX(var(--drift));
      opacity: 0;
    }
  }

  /* ── Speedometer canvas glow ── */
  #speedometer {
    filter: drop-shadow(0 0 20px rgba(255, 60, 0, 0.1));
  }

  /* ── Reduce motion ── */
  @media (prefers-reduced-motion: reduce) {
    .error-404,
    .error-seq {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }

    .error-404-wrap::before,
    .error-404-wrap::after {
      animation: none !important;
    }

    .road-line,
    .particle {
      animation: none !important;
      display: none;
    }
  }

  /* ── Mobile optimizations ── */
  @media (hover: none) and (pointer: coarse) {
    .error-seq {
      animation-duration: 0.6s !important;
    }
  }
</style>

<script>
  // ── Speedometer canvas animation ──
  const canvas = document.getElementById("speedometer") as HTMLCanvasElement;
  const speedDisplay = document.getElementById("speed-value");

  if (canvas && speedDisplay) {
    const ctx = canvas.getContext("2d")!;
    const w = canvas.width;
    const h = canvas.height;
    const cx = w / 2;
    const cy = h / 2;
    const radius = 80;

    // Speedometer config
    const startAngle = 0.75 * Math.PI;
    const endAngle = 2.25 * Math.PI;
    const maxSpeed = 404;

    let currentSpeed = 0;
    let targetSpeed = 0;
    let animationPhase: "revving" | "idle" = "revving";
    let startTime = performance.now();

    // Needle wobble
    let wobble = 0;
    let wobbleVel = 0;

    // Mouse/touch interaction
    let isInteracting = false;

    canvas.addEventListener("mouseenter", () => {
      isInteracting = true;
    });
    canvas.addEventListener("mouseleave", () => {
      isInteracting = false;
    });
    canvas.addEventListener(
      "touchstart",
      () => {
        isInteracting = true;
      },
      { passive: true },
    );
    canvas.addEventListener(
      "touchend",
      () => {
        isInteracting = false;
      },
      { passive: true },
    );

    function drawSpeedometer(speed: number) {
      ctx.clearRect(0, 0, w, h);

      const progress = speed / maxSpeed;
      const needleAngle = startAngle + (endAngle - startAngle) * progress;

      // Background arc (track)
      ctx.beginPath();
      ctx.arc(cx, cy, radius, startAngle, endAngle);
      ctx.strokeStyle = "rgba(255, 255, 255, 0.05)";
      ctx.lineWidth = 6;
      ctx.lineCap = "round";
      ctx.stroke();

      // Tick marks
      const tickCount = 10;
      for (let i = 0; i <= tickCount; i++) {
        const t = i / tickCount;
        const angle = startAngle + (endAngle - startAngle) * t;
        const isMajor = i % 2 === 0;
        const innerR = radius - (isMajor ? 14 : 10);
        const outerR = radius - 4;

        ctx.beginPath();
        ctx.moveTo(
          cx + Math.cos(angle) * innerR,
          cy + Math.sin(angle) * innerR,
        );
        ctx.lineTo(
          cx + Math.cos(angle) * outerR,
          cy + Math.sin(angle) * outerR,
        );
        ctx.strokeStyle =
          t <= progress
            ? `rgba(255, 60, 0, ${0.4 + t * 0.5})`
            : "rgba(255, 255, 255, 0.08)";
        ctx.lineWidth = isMajor ? 2 : 1;
        ctx.stroke();
      }

      // Active arc (progress)
      if (progress > 0.005) {
        const gradient = ctx.createLinearGradient(
          cx + Math.cos(startAngle) * radius,
          cy + Math.sin(startAngle) * radius,
          cx + Math.cos(needleAngle) * radius,
          cy + Math.sin(needleAngle) * radius,
        );
        gradient.addColorStop(0, "rgba(255, 107, 53, 0.8)");
        gradient.addColorStop(1, "rgba(255, 60, 0, 1)");

        ctx.beginPath();
        ctx.arc(cx, cy, radius, startAngle, needleAngle);
        ctx.strokeStyle = gradient;
        ctx.lineWidth = 6;
        ctx.lineCap = "round";
        ctx.stroke();

        // Glow on active arc
        ctx.beginPath();
        ctx.arc(cx, cy, radius, startAngle, needleAngle);
        ctx.strokeStyle = `rgba(255, 60, 0, ${0.15 + progress * 0.2})`;
        ctx.lineWidth = 14;
        ctx.stroke();
      }

      // Needle
      const wobbledAngle = needleAngle + wobble * 0.02;
      const needleLen = radius - 22;
      const nx = cx + Math.cos(wobbledAngle) * needleLen;
      const ny = cy + Math.sin(wobbledAngle) * needleLen;

      // Needle glow
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(nx, ny);
      ctx.strokeStyle = `rgba(255, 60, 0, ${0.3 + progress * 0.3})`;
      ctx.lineWidth = 4;
      ctx.lineCap = "round";
      ctx.stroke();

      // Needle line
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(nx, ny);
      ctx.strokeStyle = "#ff3c00";
      ctx.lineWidth = 2;
      ctx.lineCap = "round";
      ctx.stroke();

      // Center dot
      ctx.beginPath();
      ctx.arc(cx, cy, 5, 0, Math.PI * 2);
      ctx.fillStyle = "#ff3c00";
      ctx.fill();

      ctx.beginPath();
      ctx.arc(cx, cy, 3, 0, Math.PI * 2);
      ctx.fillStyle = "#1a1a1a";
      ctx.fill();

      // Tip glow dot
      ctx.beginPath();
      ctx.arc(nx, ny, 3, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255, 60, 0, ${0.5 + progress * 0.5})`;
      ctx.fill();
    }

    function animate(now: number) {
      const elapsed = (now - startTime) / 1000;

      if (animationPhase === "revving") {
        // Rev up to 404 in ~2s with easing
        const t = Math.min(elapsed / 2, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        targetSpeed = eased * maxSpeed;

        if (t >= 1) {
          animationPhase = "idle";
          startTime = now;
        }
      } else {
        // Idle: gentle oscillation
        const base = isInteracting ? maxSpeed : maxSpeed * 0.75;
        const osc = Math.sin(elapsed * 1.2) * 30 + Math.sin(elapsed * 3.1) * 12;
        targetSpeed = base + osc;
      }

      // Smooth follow
      currentSpeed += (targetSpeed - currentSpeed) * 0.08;

      // Wobble physics
      const speedDelta = targetSpeed - currentSpeed;
      wobbleVel += speedDelta * 0.003 - wobble * 0.15 - wobbleVel * 0.3;
      wobble += wobbleVel;

      drawSpeedometer(Math.max(0, Math.min(maxSpeed, currentSpeed)));
      if (speedDisplay) {
        speedDisplay.textContent = Math.round(currentSpeed).toString();
      }

      requestAnimationFrame(animate);
    }

    // Start after entrance animation
    setTimeout(() => {
      requestAnimationFrame(animate);
    }, 700);
  }

  // ── Floating particles ──
  const particlesContainer = document.getElementById("particles");
  if (particlesContainer) {
    for (let i = 0; i < 15; i++) {
      const p = document.createElement("div");
      p.className = "particle";
      p.style.left = Math.random() * 100 + "%";
      p.style.bottom = "-10px";
      p.style.setProperty("--drift", (Math.random() - 0.5) * 80 + "px");
      p.style.animationDuration = 4 + Math.random() * 6 + "s";
      p.style.animationDelay = Math.random() * 5 + "s";
      p.style.width = 1 + Math.random() * 2 + "px";
      p.style.height = p.style.width;
      p.style.opacity = (0.15 + Math.random() * 0.3).toString();
      particlesContainer.appendChild(p);
    }
  }

  // ── Button press feedback ──
  document.querySelectorAll(".btn-glow").forEach((button) => {
    const press = () => button.classList.add("btn-pressing");
    const release = () => button.classList.remove("btn-pressing");
    button.addEventListener("mousedown", press);
    button.addEventListener("mouseup", release);
    button.addEventListener("mouseleave", release);
    button.addEventListener("touchstart", press, { passive: true });
    button.addEventListener("touchend", release, { passive: true });
    button.addEventListener("touchcancel", release, { passive: true });
  });
</script>
