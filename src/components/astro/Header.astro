---
interface Props {
  showBackLink?: boolean;
}

const { showBackLink = false } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 px-4 md:px-8 py-4 bg-gradient-to-b from-black/80 to-transparent z-50">
  <div class="w-full mx-auto flex justify-between items-center">
    {showBackLink ? (
      <a href="/" class="btn btn-ghost gap-2 text-text-secondary text-sm font-medium hover:text-accent-primary active:text-accent-primary px-0 min-h-[44px] inline-flex items-center touch-manipulation group">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-150 group-hover:-translate-x-1 group-active:-translate-x-1">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Exit</span>
      </a>
    ) : (
      <>
        <!-- Logo (text only) -->
        <a href="/" class="no-underline group min-h-[44px] inline-flex items-center touch-manipulation flex-shrink-0">
          <span class="text-sm md:text-base lg:text-2xl font-extrabold uppercase tracking-tight text-text-primary transition-colors duration-300 group-hover:text-accent-primary group-active:text-accent-primary whitespace-nowrap">
            Car<span class="text-gradient-accent">Logo</span>Quiz
          </span>
        </a>
        
        <!-- Navigation -->
        <nav class="flex items-center gap-2 md:gap-4 lg:gap-8 flex-shrink-0">
          <a href="/about" class="text-xs md:text-sm font-medium tracking-widest uppercase text-text-secondary opacity-70 hover:opacity-100 active:opacity-100 hover:text-text-primary active:text-text-primary transition-opacity duration-150 min-h-[44px] inline-flex items-center touch-manipulation px-2 md:px-0">
            About
          </a>
          <a href="/faq" class="text-xs md:text-sm font-medium tracking-widest uppercase text-text-secondary opacity-70 hover:opacity-100 active:opacity-100 hover:text-text-primary active:text-text-primary transition-opacity duration-150 min-h-[44px] inline-flex items-center touch-manipulation px-2 md:px-0">
            FAQ
          </a>
          <span class="btn btn-sm md:btn-md border border-white/10 bg-white/5 text-white/40 text-[10px] md:text-xs lg:text-sm font-semibold tracking-widest uppercase min-h-[44px] min-w-[44px] inline-flex items-center justify-center touch-manipulation btn-header whitespace-nowrap px-3 md:px-4">
            Coming Soon
          </span>
        </nav>
      </>
    )}
  </div>
</header>

<style>
  .touch-manipulation {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
  }

  .btn-header {
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-header.btn-pressing {
    transform: translateY(-0.125rem) scale(0.98);
    box-shadow: 0 0 20px rgba(255, 60, 0, 0.4);
    transition: transform 0.05s ease, box-shadow 0.05s ease;
  }

  @media (hover: none) and (pointer: coarse) {
    a, button {
      min-height: 44px;
      min-width: 44px;
    }

    * {
      -webkit-tap-highlight-color: rgba(255, 60, 0, 0.1);
    }

    .btn-header {
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      transform: translateZ(0);
    }
  }

  header {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  @media (max-width: 375px) {
    header {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    nav {
      gap: 0.25rem !important;
    }

    .btn-header {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      font-size: 9px;
    }
  }

  @media (max-width: 640px) {
    header a[href="/"] span {
      font-size: clamp(0.75rem, 3.5vw, 1rem);
    }

    header .w-full {
      gap: 0.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.btn-header').forEach((button) => {
    const addPressEffect = () => button.classList.add('btn-pressing');
    const removePressEffect = () => button.classList.remove('btn-pressing');

    button.addEventListener('mousedown', addPressEffect);
    button.addEventListener('mouseup', removePressEffect);
    button.addEventListener('mouseleave', removePressEffect);
    button.addEventListener('touchstart', addPressEffect, { passive: true });
    button.addEventListener('touchend', removePressEffect, { passive: true });
    button.addEventListener('touchcancel', removePressEffect, { passive: true });
  });
</script>