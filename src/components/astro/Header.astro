---
interface Props {
  showBackLink?: boolean;
}

const { showBackLink = false } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 px-4 md:px-8 py-4 bg-gradient-to-b from-black/80 to-transparent z-50">
  <div class="w-full mx-auto flex justify-between items-center">
    {showBackLink ? (
      <a href="/" class="btn btn-ghost gap-2 text-text-secondary text-sm font-medium hover:text-accent-primary px-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-150 group-hover:-translate-x-1">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Exit</span>
      </a>
    ) : (
      <>
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 no-underline group">
          <img src="/images/logo.svg" alt="CarLogoQuiz" class="w-10 h-10 shrink-0 rounded-full" />
          <span class="text-base md:text-2xl font-extrabold uppercase tracking-tight text-text-primary transition-colors duration-300 group-hover:text-accent-primary">
            Car<span class="text-gradient-accent">Logo</span>Quiz
          </span>
        </a>
        
        <!-- Navigation -->
        <nav class="flex items-center gap-4 md:gap-8">
          <a href="/faq" class="hidden md:inline-block text-sm font-medium tracking-widest uppercase text-text-secondary opacity-70 hover:opacity-100 hover:text-text-primary transition-opacity duration-150">
            FAQ
          </a>
          <a href="/quiz" class="btn btn-sm md:btn-md bg-gradient-accent border-0 text-white text-xs md:text-sm font-semibold tracking-widest uppercase hover:-translate-y-0.5 hover:shadow-glow-sm transition-all duration-150">
            Play Now
          </a>
        </nav>
      </>
    )}
  </div>
</header>