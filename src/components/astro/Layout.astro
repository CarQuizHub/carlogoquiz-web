---
import "../../styles/global.css"; // ✅ add this

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Test your knowledge of car brand logos! Can you identify 15 car logos and prove you're a true automotive enthusiast?",
} = Astro.props;

const fullTitle =
  title === "Home" ? "Car Logo Quiz" : `${title} | Car Logo Quiz`;
---

<!doctype html>
<html lang="en" data-theme="carlogoquiz">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ff3c00" />
    <meta name="msapplication-TileColor" content="#0a0a0a" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#0a0a0a" />

    <title>{fullTitle}</title>
  </head>
  <body class="scrollbar-custom">
    <div class="flex min-h-screen flex-col">
      <slot />
    </div>
  </body>
</html>
