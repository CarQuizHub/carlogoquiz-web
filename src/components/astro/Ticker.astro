---
type LogoItem = {
  src: string;
  alt: string;
};

interface Props {
  items: LogoItem[];
  speedSeconds?: number;
  sizePx?: number;
  title?: string;
}

const {
  items,
  speedSeconds = 22,
  sizePx = 28,
  title
} = Astro.props;

const loopItems = [...items, ...items, ...items];
---

<div class="w-full">
  <div
    class="ticker relative overflow-hidden rounded-3xl border-y border-white/5 bg-bg-secondary/50"
    style={`--ticker-duration:${speedSeconds}s; --logo-size:${sizePx}px;`}
    data-ticker
  >
  <!-- Label inside the ticker -->
  <div class="flex items-center gap-4 pt-4 pb-1 px-6 md:px-10 relative z-30">
    <div class="flex-1 h-px bg-gradient-to-r from-transparent to-white/10"></div>
    <span class="font-mono text-xs uppercase tracking-widest text-text-muted whitespace-normal text-center md:whitespace-nowrap">{title}
    </span>
    <div class="flex-1 h-px bg-gradient-to-l from-transparent to-white/10"></div>
  </div>

    <!-- Edge fades — layered for depth -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-20 md:w-28 z-20 ticker-fade-left"></div>
    <div class="pointer-events-none absolute inset-y-0 left-0 w-10 md:w-16 z-21 ticker-glow-left"></div>

    <div class="pointer-events-none absolute inset-y-0 right-0 w-20 md:w-28 z-20 ticker-fade-right"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-10 md:w-16 z-21 ticker-glow-right"></div>

    <div class="ticker-track relative z-10 flex items-center gap-6 md:gap-8 py-4 px-4 md:px-6">
      {loopItems.map((item) => (
        <div class="ticker-item" data-ticker-item>
          <img
            src={item.src}
            alt={item.alt}
            loading="lazy"
            class="ticker-logo select-none"
            draggable="false"
          />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .ticker {
    transform: translateZ(0);
  }

  .ticker-logo {
    width: var(--logo-size);
    height: var(--logo-size);
    object-fit: contain;
    padding: 1px;
    box-sizing: border-box;
    filter: grayscale(0.05);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .ticker-item {
    width: calc(var(--logo-size) + 28px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .ticker.is-hovering .ticker-item {
    opacity: 0.35;
  }

  .ticker.is-hovering .ticker-item.is-closest {
    opacity: 1;
  }

  .ticker.is-hovering .ticker-item.is-closest .ticker-logo {
    filter: grayscale(0) brightness(1.1) drop-shadow(0 0 6px rgba(255, 255, 255, 0.15));
    transform: scale(1.3);
  }

  .ticker-track {
    width: max-content;
    will-change: transform;
  }

  /* ── Primary fade: wide, smooth, multi-stop ── */
  .ticker-fade-left {
    background: linear-gradient(
      to right,
      rgba(11, 11, 11, 1) 0%,
      rgba(11, 11, 11, 0.95) 20%,
      rgba(11, 11, 11, 0.7) 45%,
      rgba(11, 11, 11, 0.3) 70%,
      rgba(11, 11, 11, 0) 100%
    );
  }

  .ticker-fade-right {
    background: linear-gradient(
      to left,
      rgba(11, 11, 11, 1) 0%,
      rgba(11, 11, 11, 0.95) 20%,
      rgba(11, 11, 11, 0.7) 45%,
      rgba(11, 11, 11, 0.3) 70%,
      rgba(11, 11, 11, 0) 100%
    );
  }

  /* ── Accent glow layer: subtle color bleed at the very edge ── */
  .ticker-glow-left {
    background: linear-gradient(
      to right,
      rgba(255, 60, 0, 0.25) 0%,
      rgba(255, 60, 0, 0.03) 40%,
      transparent 100%
    );
    mix-blend-mode: screen;
  }

  .ticker-glow-right {
    background: linear-gradient(
      to left,
      rgba(255, 60, 0, 0.25) 0%,
      rgba(255, 60, 0, 0.03) 40%,
      transparent 100%
    );
    mix-blend-mode: screen;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-ticker]").forEach((ticker) => {
    const track = ticker.querySelector<HTMLElement>(".ticker-track");
    if (!track) return;

    const items = ticker.querySelectorAll<HTMLElement>("[data-ticker-item]");
    let animation: Animation | null = null;
    const TARGET_RATE = 0.2;
    const LERP_SPEED = 0.08;
    let currentRate = 1;
    let targetRate = 1;
    let rafId: number | null = null;

    const speedSeconds = parseFloat(
      getComputedStyle(ticker).getPropertyValue("--ticker-duration")
    );

    function lerpRate() {
      if (!animation) return;
      currentRate += (targetRate - currentRate) * LERP_SPEED;

      if (Math.abs(currentRate - targetRate) < 0.005) {
        currentRate = targetRate;
        animation.playbackRate = currentRate;
        rafId = null;
        return;
      }

      animation.playbackRate = currentRate;
      rafId = requestAnimationFrame(lerpRate);
    }

    function setTargetRate(rate: number) {
      targetRate = rate;
      if (!rafId) rafId = requestAnimationFrame(lerpRate);
    }

    function initAnimation() {
      if (animation) return;

      const totalChildren = track!.children.length;
      const oneSetCount = totalChildren / 3;
      const firstItem = track!.children[0] as HTMLElement;
      const oneSetEnd = track!.children[oneSetCount] as HTMLElement;
      const oneSetWidth = oneSetEnd.offsetLeft - firstItem.offsetLeft;

      animation = track!.animate(
        [
          { transform: "translateX(0)" },
          { transform: `translateX(-${oneSetWidth}px)` },
        ],
        {
          duration: speedSeconds * 1000,
          iterations: Infinity,
          easing: "linear",
        }
      );

      currentRate = 1;
    }

    initAnimation();

    ticker.addEventListener("mouseenter", () => {
      ticker.classList.add("is-hovering");
      setTargetRate(TARGET_RATE);
    });

    ticker.addEventListener("mouseleave", () => {
      ticker.classList.remove("is-hovering");
      setTargetRate(1);
      for (const item of items) {
        item.classList.remove("is-closest");
      }
    });

    ticker.addEventListener("mousemove", (e) => {
      const mouseX = e.clientX;
      let closestItem: HTMLElement | null = null;
      let closestDist = Infinity;

      for (const item of items) {
        const rect = item.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const dist = Math.abs(mouseX - centerX);
        if (dist < closestDist) {
          closestDist = dist;
          closestItem = item;
        }
      }

      for (const item of items) {
        item.classList.remove("is-closest");
      }
      closestItem?.classList.add("is-closest");
    });
  });
</script>