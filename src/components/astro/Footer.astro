---
const currentYear = new Date().getFullYear();
---

<footer class="relative mt-16 w-full overflow-visible md:mt-24">
  <!-- Top divider -->
  <div
    class="h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <div
    class="pointer-events-none absolute bottom-0 left-0 right-0 h-[1000px]"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 90% 50% at 50% 100%,rgba(255, 60, 0, 0.12), transparent 70%), radial-gradient(circle at 30% 95%, rgba(255, 107, 53, 0.07), transparent 60%), radial-gradient(circle at 70% 90%, rgba(255, 60, 0, 0.06), transparent 60%);"
  >
  </div>
  <div
    class="footer footer-center bg-bg-secondary/50 px-6 py-12 text-text-muted md:py-16"
  >
    <div class="mx-auto flex w-full max-w-4xl flex-col items-center gap-10">
      <!-- Logo & Tagline -->
      <div class="flex flex-col items-center gap-3">
        <a
          href="/"
          class="text-xl font-extrabold uppercase tracking-tight text-text-primary transition-colors duration-300 hover:text-accent-primary"
        >
          Car<span class="text-gradient-accent">Logo</span>Quiz
        </a>
        <p
          class="font-mono text-xs uppercase tracking-widest text-text-muted/60"
        >
          Test Your Automotive Knowledge
        </p>
      </div>

      <!-- Nav Links -->
      <nav class="flex flex-wrap justify-center gap-x-8 gap-y-3">
        <a
          href="/quiz"
          class="font-mono text-xs uppercase tracking-wider text-text-muted transition-colors duration-300 hover:text-accent-primary"
          >Play</a
        >
        <a
          href="/about"
          class="font-mono text-xs uppercase tracking-wider text-text-muted transition-colors duration-300 hover:text-accent-primary"
          >About</a
        >
        <a
          href="/faq"
          class="font-mono text-xs uppercase tracking-wider text-text-muted transition-colors duration-300 hover:text-accent-primary"
          >FAQ</a
        >
        <a
          href="/privacy"
          class="font-mono text-xs uppercase tracking-wider text-text-muted transition-colors duration-300 hover:text-accent-primary"
          >Privacy</a
        >
        <a
          href="/contact"
          class="font-mono text-xs uppercase tracking-wider text-text-muted transition-colors duration-300 hover:text-accent-primary"
          >Contact</a
        >
      </nav>

      <!-- Socials -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/CarQuizHub/carlogoquiz-web"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Frontend"
          class="group flex flex-col items-center gap-3"
        >
          <div
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/5 bg-bg-tertiary/50 text-text-muted transition-all duration-300 group-hover:border-accent-primary/20 group-hover:text-accent-primary group-active:border-accent-primary/20 group-active:text-accent-primary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </div>
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-text-muted/65 transition-colors duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
            >Web</span
          >
        </a>
        <a
          href="https://github.com/CarQuizHub/carlogoquiz-api"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Backend"
          class="group flex flex-col items-center gap-3"
        >
          <div
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/5 bg-bg-tertiary/50 text-text-muted transition-all duration-300 group-hover:border-accent-primary/20 group-hover:text-accent-primary group-active:border-accent-primary/20 group-active:text-accent-primary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </div>
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-text-muted/65 transition-colors duration-300 group-hover:text-accent-primary group-active:text-accent-primary"
            >Api</span
          >
        </a>
      </div>

      <!-- Divider -->
      <div
        class="h-px w-full max-w-md bg-gradient-to-r from-transparent via-white/5 to-transparent"
      >
      </div>

      <!-- Trademark & Copyright -->
      <div class="flex max-w-lg flex-col items-center gap-3">
        <p
          class="text-center font-mono text-[10px] leading-relaxed text-text-muted/60"
        >
          All logos, trademarks, and brand names displayed in this quiz are the
          property of their respective owners. This project is not affiliated
          with, endorsed by, or sponsored by any automobile manufacturer.
        </p>
        <p class="font-mono text-[10px] text-text-muted/50">
          &copy; {currentYear} CarLogoQuiz. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
