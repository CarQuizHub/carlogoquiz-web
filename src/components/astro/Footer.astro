---
const currentYear = new Date().getFullYear();
---

<footer class="w-full mt-16 md:mt-24 relative overflow-visible">
  <!-- Top divider -->
  <div class="w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

    <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-[1000px]" aria-hidden="true"
    style="background: radial-gradient(ellipse 90% 50% at 50% 100%, rgba(255, 60, 0, 0.05), transparent 70%), radial-gradient(circle at 30% 95%, rgba(255, 107, 53, 0.03), transparent 60%), radial-gradient(circle at 70% 90%, rgba(255, 60, 0, 0.025), transparent 60%);">
    </div>
  <div class="footer footer-center bg-bg-secondary/50 px-6 py-12 md:py-16 text-text-muted">
    <div class="max-w-4xl mx-auto w-full flex flex-col items-center gap-10">
      
      <!-- Logo & Tagline -->
      <div class="flex flex-col items-center gap-3">
        <a href="/" class="text-xl font-extrabold uppercase tracking-tight text-text-primary hover:text-accent-primary transition-colors duration-300">
          Car<span class="text-gradient-accent">Logo</span>Quiz
        </a>
        <p class="text-xs font-mono uppercase tracking-widest text-text-muted/60">
          Test Your Automotive Knowledge
        </p>
      </div>

      <!-- Nav Links -->
      <nav class="flex flex-wrap justify-center gap-x-8 gap-y-3">
        <a href="/quiz" class="text-xs font-mono uppercase tracking-wider text-text-muted hover:text-accent-primary transition-colors duration-300">Play</a>
        <a href="/about" class="text-xs font-mono uppercase tracking-wider text-text-muted hover:text-accent-primary transition-colors duration-300">About</a>
        <a href="/privacy" class="text-xs font-mono uppercase tracking-wider text-text-muted hover:text-accent-primary transition-colors duration-300">Privacy</a>
        <a href="/contact" class="text-xs font-mono uppercase tracking-wider text-text-muted hover:text-accent-primary transition-colors duration-300">Contact</a>
      </nav>

        <!-- Socials -->
        <div class="flex flex-col items-center gap-3">
            <div class="flex items-center gap-4">
                <a href="https://github.com/CarQuizHub/carlogoquiz-web" target="_blank" rel="noopener noreferrer" aria-label="GitHub Frontend" class="w-9 h-9 rounded-lg bg-bg-tertiary/50 border border-white/5 flex items-center justify-center text-text-muted hover:text-accent-primary hover:border-accent-primary/20 transition-all duration-300">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                </a>
                <a href="https://github.com/CarQuizHub/carlogoquiz-api" target="_blank" rel="noopener noreferrer" aria-label="GitHub Backend" class="w-9 h-9 rounded-lg bg-bg-tertiary/50 border border-white/5 flex items-center justify-center text-text-muted hover:text-accent-primary hover:border-accent-primary/20 transition-all duration-300">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                </a>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted/40 w-9 text-center">Web</span>
                <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted/40 w-9 text-center">Api</span>
            </div>
        </div>

      <!-- Divider -->
      <div class="w-full max-w-md h-px bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>

      <!-- Trademark & Copyright -->
      <div class="flex flex-col items-center gap-3 max-w-lg">
        <p class="text-[10px] leading-relaxed text-center text-text-muted/40 font-mono">
          All logos, trademarks, and brand names displayed in this quiz are the property of their respective owners. This project is not affiliated with, endorsed by, or sponsored by any automobile manufacturer.
        </p>
        <p class="text-[10px] text-text-muted/30 font-mono">
          &copy; {currentYear} CarLogoQuiz. All rights reserved.
        </p>
      </div>

    </div>
  </div>
</footer>