{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carlogoquiz-web",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-01-29",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "635c7b208e581906817cd6e7b0b69617",
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "carlogoquiz.com", "custom_domain": true },
    { "pattern": "www.carlogoquiz.com", "custom_domain": true }
  ],
  "env": {
    "dev": {
      "name": "carlogoquiz-web-dev",
      "workers_dev": false,
      "routes": [{ "pattern": "dev.carlogoquiz.com", "custom_domain": true }]
    },
    "staging": {
      "name": "carlogoquiz-web-staging",
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.carlogoquiz.com", "custom_domain": true }
      ]
    }
  }
}
